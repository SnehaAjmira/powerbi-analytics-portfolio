          {
            "type": "calculated",
            "name": "Age Days",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "VAR DataDate = MAX ( project_info[Data_Date] )",
              "VAR EndDate =",
              "    IF ( ISBLANK ( fact_rfi[Date_Closed] ), DataDate, fact_rfi[Date_Closed] )",
              "RETURN",
              "    INT ( EndDate - fact_rfi[Date_Raised] )"
            ],
            "lineageTag": "d4011992-ac64-424b-91b6-8d39dccc13a1",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Age Bucket",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH (",
              "    TRUE (),",
              "    fact_rfi[Age Days] <= 7, \"0-7 days\",",
              "    fact_rfi[Age Days] <= 14, \"8-14 days\",",
              "    fact_rfi[Age Days] <= 30, \"15-30 days\",",
              "    \"Over 30 days\"",
              ")"
            ],
            "lineageTag": "565021d2-757e-4441-985f-fbb6ad8ed209",
            "summarizeBy": "none",
            "sortByColumn": "Age Bucket Sort"
          },
          {
            "type": "calculated",
            "name": "Age Bucket Sort",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "SWITCH ( fact_rfi[Age Bucket], \"0-7 days\", 1, \"8-14 days\", 2, \"15-30 days\", 3, 4 )",
              "// Sort [Age Bucket] by [Age Bucket Sort]."
            ],
            "lineageTag": "25c7d917-0270-4d24-b4af-ff8448cef415",
            "summarizeBy": "none"
          }
        ],
