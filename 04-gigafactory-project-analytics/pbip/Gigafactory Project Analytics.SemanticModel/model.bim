            "lineageTag": "b1b0a626-45d1-422f-bce3-6e8dbb3426a1",
            "summarizeBy": "none",
            "isKey": true,
            "formatString": "Short Date"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Year]",
            "lineageTag": "63318fd4-7ff9-4579-bee7-05df0f2044d6",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month No",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month No]",
            "lineageTag": "13a61f80-12b3-4887-8c68-55e950f6c20b",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Month",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Month]",
            "lineageTag": "f2c2d076-db30-4a13-a624-66df35129033",
            "summarizeBy": "none",
            "sortByColumn": "Month No"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year Month",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Year Month]",
            "lineageTag": "d15251b0-569d-4ffb-9065-3ff62b99d0c9",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Quarter",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Quarter]",
            "lineageTag": "398cb921-ab99-455c-b5cc-87d0e5cd14c8",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Year Quarter",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Year Quarter]",
            "lineageTag": "919d377b-02a2-4055-a406-3ad126183d21",
            "summarizeBy": "none"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Week Ending",
            "dataType": "dateTime",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Week Ending]",
            "lineageTag": "4123955f-8e0c-4d66-b67f-8b339cb24bda",
            "summarizeBy": "none",
            "formatString": "Short Date"
          }
        ],
        "partitions": [
          {
            "name": "dim_date",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "VAR StartDate = DATE ( 2024, 1, 1 )",
                "VAR EndDate = DATE ( 2027, 12, 31 )",
                "RETURN",
                "    ADDCOLUMNS (",
                "        CALENDAR ( StartDate, EndDate ),",
                "        \"Year\", YEAR ( [Date] ),",
                "        \"Month No\", MONTH ( [Date] ),",
                "        \"Month\", FORMAT ( [Date], \"MMM\" ),",
                "        \"Year Month\", FORMAT ( [Date], \"YYYY-MM\" ),",
                "        \"Quarter\", \"Q\" & FORMAT ( [Date], \"Q\" ),",
                "        \"Year Quarter\", YEAR ( [Date] ) & \" Q\" & FORMAT ( [Date], \"Q\" ),",
                "        \"Week Ending\", [Date] + MOD ( 6 - WEEKDAY ( [Date], 1 ), 7 )   // Friday week-ending, matches progress data",
                "    )"
              ]
            }
          }
        ]
      },
