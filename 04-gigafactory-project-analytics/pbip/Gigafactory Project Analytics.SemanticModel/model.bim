{
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "_Measures",
        "lineageTag": "3fadf48c-466f-4a7c-a04a-f74b36cc4a16",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "x",
            "dataType": "string",
            "isHidden": true,
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[x]",
            "lineageTag": "e7656ddc-80e8-450a-9327-2d7566dd4df2",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "_Measures",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "ROW ( \"x\", BLANK () )"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Data Date",
            "expression": [
              "MAX ( project_info[Data_Date] )"
            ],
            "lineageTag": "3d02cb20-f2f1-4f6d-8d12-0452b344292f",
            "formatString": "dd mmm yyyy"
          },
          {
            "name": "Curve End Date",
            "expression": [
              "// last date on the axis, capped at the data date (used by actual curves and KPIs)",
              "MIN ( MAX ( dim_date[Date] ), [Data Date] )"
            ],
            "lineageTag": "347bcf35-362b-4edf-8421-f31ec746f68f",
            "formatString": "dd mmm yyyy"
          },
          {
            "name": "Documents",
            "expression": [
              "CALCULATE ( DISTINCTCOUNT ( fact_document_revisions[Doc_No] ), REMOVEFILTERS ( dim_date ) )"
            ],
            "lineageTag": "ec2aab36-5a7f-4980-af41-e6590be19445",
            "formatString": "#,0"
          },
          {
            "name": "IFC Planned (Cum)",
            "expression": [
              "VAR d = MAX ( dim_date[Date] )",
              "RETURN",
              "    CALCULATE (",
              "        COUNTROWS ( fact_document_revisions ),",
              "        REMOVEFILTERS ( dim_date ),",
              "        fact_document_revisions[Revision] = \"0\",",
              "        fact_document_revisions[Planned_Issue_Date] <= d",
              "    )"
            ],
            "lineageTag": "99dab6fd-8c75-4ca1-96a2-d3d4cc8bc33d",
            "formatString": "#,0"
          },
          {
            "name": "IFC Actual (Cum)",
            "expression": [
              "VAR d = MAX ( dim_date[Date] )",
              "RETURN",
              "    IF (",
              "        MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE (",
              "            COUNTROWS ( fact_document_revisions ),",
              "            REMOVEFILTERS ( dim_date ),",
              "            fact_document_revisions[Revision] = \"0\",",
              "            fact_document_revisions[Actual_Issue_Date] <= d",
              "        )",
              "    )"
            ],
            "lineageTag": "d4072ff5-c943-4570-b67b-6445a84336ed",
            "formatString": "#,0"
          },
          {
            "name": "IFC % Planned",
            "expression": [
              "VAR dd = [Data Date]",
              "RETURN",
              "    DIVIDE (",
              "        CALCULATE ( COUNTROWS ( fact_document_revisions ), REMOVEFILTERS ( dim_date ),",
              "            fact_document_revisions[Revision] = \"0\", fact_document_revisions[Planned_Issue_Date] <= dd ),",
              "        CALCULATE ( COUNTROWS ( fact_document_revisions ), REMOVEFILTERS ( dim_date ),",
              "            fact_document_revisions[Revision] = \"0\" )",
              "    )"
            ],
            "lineageTag": "91c093b0-7faf-4acd-ad86-40be9b7c0b22",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "IFC % Complete",
            "expression": [
              "VAR dd = [Data Date]",
              "RETURN",
              "    DIVIDE (",
              "        CALCULATE ( COUNTROWS ( fact_document_revisions ), REMOVEFILTERS ( dim_date ),",
              "            fact_document_revisions[Revision] = \"0\", fact_document_revisions[Actual_Issue_Date] <= dd ),",
              "        CALCULATE ( COUNTROWS ( fact_document_revisions ), REMOVEFILTERS ( dim_date ),",
              "            fact_document_revisions[Revision] = \"0\" )",
              "    )"
            ],
            "lineageTag": "4fabfe0f-1b90-4f9d-b13f-06763865a04c",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "IFC Variance (pts)",
            "expression": [
              "( [IFC % Complete] - [IFC % Planned] ) * 100"
            ],
            "lineageTag": "d3ac6f57-8008-4eea-b78a-77ebbf9d2919",
            "formatString": "#,0"
          },
          {
            "name": "IFC Behind Plan",
            "expression": [
              "// documents whose IFC was planned by the data date but not yet issued",
              "VAR dd = [Data Date]",
              "RETURN",
              "    CALCULATE (",
              "        COUNTROWS ( fact_document_revisions ),",
              "        REMOVEFILTERS ( dim_date ),",
              "        fact_document_revisions[Revision] = \"0\",",
              "        fact_document_revisions[Planned_Issue_Date] <= dd,",
              "        ISBLANK ( fact_document_revisions[Actual_Issue_Date] )",
              "    )"
            ],
            "lineageTag": "e55ae344-41d8-467f-9295-6ff5062d2c16",
            "formatString": "#,0"
          },
          {
            "name": "Reviews Outstanding",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( fact_document_revisions ),",
              "    REMOVEFILTERS ( dim_date ),",
              "    NOT ISBLANK ( fact_document_revisions[Review_Due_Date] ),",
              "    ISBLANK ( fact_document_revisions[Review_Return_Date] )",
              ")"
            ],
            "lineageTag": "f3c5a5cd-a637-4625-866b-e24c49ceff58",
            "formatString": "#,0"
          },
          {
            "name": "Reviews Overdue",
            "expression": [
              "VAR dd = [Data Date]",
              "RETURN",
              "    CALCULATE (",
              "        COUNTROWS ( fact_document_revisions ),",
              "        REMOVEFILTERS ( dim_date ),",
              "        NOT ISBLANK ( fact_document_revisions[Review_Due_Date] ),",
              "        ISBLANK ( fact_document_revisions[Review_Return_Date] ),",
              "        fact_document_revisions[Review_Due_Date] < dd",
              "    )"
            ],
            "lineageTag": "505c79de-9d8f-4587-9e5f-f381b410f1cb",
            "formatString": "#,0"
          },
          {
            "name": "Avg Review Cycle (days)",
            "expression": [
              "AVERAGE ( fact_document_revisions[Review Cycle Days] )"
            ],
            "lineageTag": "23200f88-a80e-4995-bf7f-918549a908d9",
            "formatString": "#,0.0"
          },
          {
            "name": "First-Pass Approval %",
            "expression": [
              "// share of first submissions (Rev A) returned Code 1 or 2",
              "VAR Returned =",
              "    CALCULATE ( COUNTROWS ( fact_document_revisions ),",
              "        fact_document_revisions[Revision] = \"A\", fact_document_revisions[Review_Code] <> \"\" )",
              "VAR Approved =",
              "    CALCULATE ( COUNTROWS ( fact_document_revisions ),",
              "        fact_document_revisions[Revision] = \"A\", fact_document_revisions[Review_Code] IN { \"1\", \"2\" } )",
              "RETURN DIVIDE ( Approved, Returned )"
            ],
            "lineageTag": "e505122f-b452-4b26-b9a0-1cdd0c740a13",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "RFIs Raised",
            "expression": [
              "COUNTROWS ( fact_rfi )"
            ],
            "lineageTag": "3b46f0f9-cbdb-4890-af13-5f59ebb0f53f",
            "formatString": "#,0"
          },
          {
            "name": "RFIs Open",
            "expression": [
              "// open as of the axis date (or the data date on a card)",
              "VAR d = [Curve End Date]",
              "RETURN",
              "    IF (",
              "        MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE (",
              "            COUNTROWS ( fact_rfi ),",
              "            REMOVEFILTERS ( dim_date ),",
              "            fact_rfi[Status] <> \"Void\",",
              "            fact_rfi[Date_Raised] <= d,",
              "            ISBLANK ( fact_rfi[Date_Closed] ) || fact_rfi[Date_Closed] > d",
              "        )",
              "    )"
            ],
            "lineageTag": "23f38a0e-4602-43c3-8001-1d9cb750e60f",
            "formatString": "#,0"
          },
          {
            "name": "RFIs Overdue",
            "expression": [
              "// no response yet and past the required date",
              "VAR d = [Curve End Date]",
              "RETURN",
              "    IF (",
              "        MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE (",
              "            COUNTROWS ( fact_rfi ),",
              "            REMOVEFILTERS ( dim_date ),",
              "            fact_rfi[Status] <> \"Void\",",
              "            fact_rfi[Date_Raised] <= d,",
              "            fact_rfi[Date_Required] < d,",
              "            ISBLANK ( fact_rfi[Date_Responded] ) || fact_rfi[Date_Responded] > d",
              "        )",
              "    )"
            ],
            "lineageTag": "4a5e837e-6bce-46dd-b6e2-b817663dd75d",
            "formatString": "#,0"
          },
          {
            "name": "Avg Days to Respond",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( fact_rfi, NOT ISBLANK ( fact_rfi[Date_Responded] ) ),",
              "    INT ( fact_rfi[Date_Responded] - fact_rfi[Date_Raised] )",
              ")"
            ],
            "lineageTag": "35a67f39-dbb0-490b-9c98-7eaff8635095",
            "formatString": "#,0.0"
          },
          {
            "name": "RFI On-Time Response %",
            "expression": [
              "VAR Responded = FILTER ( fact_rfi, NOT ISBLANK ( fact_rfi[Date_Responded] ) )",
              "RETURN",
              "    DIVIDE (",
              "        COUNTROWS ( FILTER ( Responded, fact_rfi[Date_Responded] <= fact_rfi[Date_Required] ) ),",
              "        COUNTROWS ( Responded )",
              "    )"
            ],
            "lineageTag": "f2036887-a499-42b1-978d-0d05549a264c",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "RFIs with Cost Impact",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_rfi ), fact_rfi[Cost_Impact] = \"Y\" )"
            ],
            "lineageTag": "743fb131-c05c-4f79-aeee-702d8849984c",
            "formatString": "#,0"
          },
          {
            "name": "Submittals",
            "expression": [
              "COUNTROWS ( fact_submittals )"
            ],
            "lineageTag": "c9a69ac6-6651-4ec4-a9aa-3a8670fa7c89",
            "formatString": "#,0"
          },
          {
            "name": "Submittals Under Review",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_submittals ), REMOVEFILTERS ( dim_date ), fact_submittals[Status] = \"Under Review\" )"
            ],
            "lineageTag": "e91b82d9-cedb-4759-ae34-aa5ea774e936",
            "formatString": "#,0"
          },
          {
            "name": "Submittals Overdue",
            "expression": [
              "VAR dd = [Data Date]",
              "RETURN",
              "    CALCULATE (",
              "        COUNTROWS ( fact_submittals ),",
              "        REMOVEFILTERS ( dim_date ),",
              "        fact_submittals[Status] = \"Under Review\",",
              "        fact_submittals[Date_Due] < dd",
              "    )"
            ],
            "lineageTag": "25d521c5-b417-4243-b693-a638c9a6dcb1",
            "formatString": "#,0"
          },
          {
            "name": "Submittal Approval %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_submittals ),",
              "        fact_submittals[Action_Code] IN { \"A - Approved\", \"B - Approved as Noted\" } ),",
              "    CALCULATE ( COUNTROWS ( fact_submittals ), fact_submittals[Status] = \"Returned\" )",
              ")"
            ],
            "lineageTag": "2d157755-e3f6-432a-8f8c-46348b20c4ff",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Avg Submittal Turnaround (days)",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( fact_submittals, NOT ISBLANK ( fact_submittals[Date_Returned] ) ),",
              "    INT ( fact_submittals[Date_Returned] - fact_submittals[Date_Submitted] )",
              ")"
            ],
            "lineageTag": "c543867f-dfde-4a42-b05d-7f3914b625da",
            "formatString": "#,0.0"
          },
          {
            "name": "PO Value",
            "expression": [
              "SUM ( fact_procurement[Line_Value_USD] )"
            ],
            "lineageTag": "8a5594b4-63a6-477b-9b89-468923ed39e6",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "PO Lines",
            "expression": [
              "COUNTROWS ( fact_procurement )"
            ],
            "lineageTag": "f08297bb-bfd1-4f5e-bea3-9df32d95e8ae",
            "formatString": "#,0"
          },
          {
            "name": "Lines Delivered %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_procurement ), NOT ISBLANK ( fact_procurement[Actual_Delivery_Date] ) ),",
              "    [PO Lines]",
              ")"
            ],
            "lineageTag": "17880896-883c-46f9-9bde-5e348d708b17",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Delivered On Time %",
            "expression": [
              "VAR Delivered = FILTER ( fact_procurement, NOT ISBLANK ( fact_procurement[Actual_Delivery_Date] ) )",
              "RETURN",
              "    DIVIDE (",
              "        COUNTROWS ( FILTER ( Delivered, fact_procurement[Actual_Delivery_Date] <= fact_procurement[ROS_Date] ) ),",
              "        COUNTROWS ( Delivered )",
              "    )"
            ],
            "lineageTag": "a2f0fc74-a408-4a46-baff-451586de6d0e",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Lines Late vs ROS",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_procurement ), fact_procurement[Expediting_Status] = \"Late vs ROS\" )"
            ],
            "lineageTag": "f7a81e0b-a21b-42b8-866f-f6f50b11e5b3",
            "formatString": "#,0"
          },
          {
            "name": "Value at Risk",
            "expression": [
              "CALCULATE ( [PO Value], fact_procurement[Expediting_Status] IN { \"Late vs ROS\", \"At Risk\" } )"
            ],
            "lineageTag": "ceb25b78-d00f-4331-957e-8178602e57cb",
            "formatString": "\\$#,0;(\\$#,0);\\$#,0"
          },
          {
            "name": "Avg Float (open lines, days)",
            "expression": [
              "CALCULATE (",
              "    AVERAGE ( fact_procurement[Float Days] ),",
              "    ISBLANK ( fact_procurement[Actual_Delivery_Date] )",
              ")"
            ],
            "lineageTag": "87ba8239-aaa7-4734-b18a-4f2ab93f2c65",
            "formatString": "#,0.0"
          },
          {
            "name": "Long-Lead Items Open",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( fact_procurement ),",
              "    fact_procurement[Long_Lead] = \"Y\",",
              "    ISBLANK ( fact_procurement[Actual_Delivery_Date] )",
              ")"
            ],
            "lineageTag": "b65aed30-08cd-4253-9219-6ccc6a7b5506",
            "formatString": "#,0"
          },
          {
            "name": "Budget Hours",
            "expression": [
              "SUM ( dim_cwp[Budget_Hours] )"
            ],
            "lineageTag": "9d1d3206-0d8d-43d7-a0d5-044d6e80ceb0",
            "formatString": "#,0"
          },
          {
            "name": "Planned Hours (Cum)",
            "expression": [
              "VAR d = MAX ( dim_date[Date] )",
              "RETURN",
              "    CALCULATE ( SUM ( fact_progress_weekly[Planned_Hours] ), REMOVEFILTERS ( dim_date ),",
              "        fact_progress_weekly[Week_Ending] <= d )"
            ],
            "lineageTag": "520e7052-1b88-4d64-ab73-bb0dba71b7be",
            "formatString": "#,0"
          },
          {
            "name": "Earned Hours (Cum)",
            "expression": [
              "VAR d = [Curve End Date]",
              "RETURN",
              "    IF (",
              "        MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE ( SUM ( fact_progress_weekly[Earned_Hours] ), REMOVEFILTERS ( dim_date ),",
              "            fact_progress_weekly[Week_Ending] <= d )",
              "    )"
            ],
            "lineageTag": "44517fb7-1203-4739-aba7-359844795118",
            "formatString": "#,0"
          },
          {
            "name": "Actual Hours (Cum)",
            "expression": [
              "VAR d = [Curve End Date]",
              "RETURN",
              "    IF (",
              "        MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE ( SUM ( fact_progress_weekly[Actual_Hours] ), REMOVEFILTERS ( dim_date ),",
              "            fact_progress_weekly[Week_Ending] <= d )",
              "    )"
            ],
            "lineageTag": "3a29b780-6310-47fc-96e2-2911b7c3f575",
            "formatString": "#,0"
          },
          {
            "name": "Planned % (Cum)",
            "expression": [
              "DIVIDE ( [Planned Hours (Cum)], [Budget Hours] )"
            ],
            "lineageTag": "ac6d0b82-cc78-4c16-8795-8f5ce3e91a8d",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Earned % (Cum)",
            "expression": [
              "DIVIDE ( [Earned Hours (Cum)], [Budget Hours] )"
            ],
            "lineageTag": "abca3581-40e6-4af3-b097-eb49bdb8669c",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Planned % to Date",
            "expression": [
              "VAR dd = [Data Date]",
              "RETURN",
              "    DIVIDE (",
              "        CALCULATE ( SUM ( fact_progress_weekly[Planned_Hours] ), REMOVEFILTERS ( dim_date ),",
              "            fact_progress_weekly[Week_Ending] <= dd ),",
              "        [Budget Hours]",
              "    )"
            ],
            "lineageTag": "322b73a1-7e0d-4606-b94b-577ba8aa4443",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Earned % to Date",
            "expression": [
              "DIVIDE ( CALCULATE ( SUM ( fact_progress_weekly[Earned_Hours] ), REMOVEFILTERS ( dim_date ) ), [Budget Hours] )"
            ],
            "lineageTag": "6590b045-235e-49ab-8310-cc1cc33b266b",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "SPI",
            "expression": [
              "// schedule performance index, cumulative to the axis date / data date",
              "VAR d = [Curve End Date]",
              "VAR Earned =",
              "    CALCULATE ( SUM ( fact_progress_weekly[Earned_Hours] ), REMOVEFILTERS ( dim_date ),",
              "        fact_progress_weekly[Week_Ending] <= d )",
              "VAR Planned =",
              "    CALCULATE ( SUM ( fact_progress_weekly[Planned_Hours] ), REMOVEFILTERS ( dim_date ),",
              "        fact_progress_weekly[Week_Ending] <= d )",
              "RETURN IF ( MIN ( dim_date[Date] ) <= [Data Date], DIVIDE ( Earned, Planned ) )"
            ],
            "lineageTag": "6616c255-5ed2-4ce1-9428-792e78f7e7bf",
            "formatString": "0.00"
          },
          {
            "name": "CPI",
            "expression": [
              "// cost (hours) performance index: earned / actual",
              "VAR d = [Curve End Date]",
              "VAR Earned =",
              "    CALCULATE ( SUM ( fact_progress_weekly[Earned_Hours] ), REMOVEFILTERS ( dim_date ),",
              "        fact_progress_weekly[Week_Ending] <= d )",
              "VAR Actual =",
              "    CALCULATE ( SUM ( fact_progress_weekly[Actual_Hours] ), REMOVEFILTERS ( dim_date ),",
              "        fact_progress_weekly[Week_Ending] <= d )",
              "RETURN IF ( MIN ( dim_date[Date] ) <= [Data Date], DIVIDE ( Earned, Actual ) )"
            ],
            "lineageTag": "d69a5fd1-4af9-49d3-a4dd-75fdc3e037c5",
            "formatString": "0.00"
          },
          {
            "name": "Productivity Factor",
            "expression": [
              "DIVIDE ( 1, [CPI] )   // > 1.0 means more hours spent than earned"
            ],
            "lineageTag": "5f53c86e-298e-4a29-b5e3-a99d5b3ccc06",
            "formatString": "0.00"
          },
          {
            "name": "Weekly SPI",
            "expression": [
              "DIVIDE ( SUM ( fact_progress_weekly[Earned_Hours] ), SUM ( fact_progress_weekly[Planned_Hours] ) )"
            ],
            "lineageTag": "3fda0860-e4e6-4c32-8a8c-65338efaa6d9",
            "formatString": "0.00"
          },
          {
            "name": "SPI Status Color",
            "expression": [
              "SWITCH ( TRUE (), ISBLANK ( [SPI] ), \"#BFBFBF\", [SPI] >= 0.98, \"#2E7D32\", [SPI] >= 0.92, \"#F4B183\", \"#C00000\" )"
            ],
            "lineageTag": "5a3f6787-d3c7-4dff-b1d1-01aea6e08af7"
          },
          {
            "name": "CPI Status Color",
            "expression": [
              "SWITCH ( TRUE (), ISBLANK ( [CPI] ), \"#BFBFBF\", [CPI] >= 0.98, \"#2E7D32\", [CPI] >= 0.92, \"#F4B183\", \"#C00000\" )"
            ],
            "lineageTag": "125168b9-7166-4e28-844b-10addc78d0ed"
          },
          {
            "name": "Tags",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_tag_register ), REMOVEFILTERS ( dim_date ) )"
            ],
            "lineageTag": "f42cb039-54e9-41a1-b531-6dab6b3ccb1b",
            "formatString": "#,0"
          },
          {
            "name": "Tags Installed %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_tag_register ), REMOVEFILTERS ( dim_date ),",
              "        fact_tag_register[Install_Status] = \"Installed\" ),",
              "    [Tags]",
              ")"
            ],
            "lineageTag": "486239e7-2d3d-4a8e-812d-e486a33469f9",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "ITR A Total",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_itr ), REMOVEFILTERS ( dim_date ), fact_itr[Stage] = \"A\" )"
            ],
            "lineageTag": "4acde8fd-402f-42c5-a8b9-6fdd5ddae823",
            "formatString": "#,0"
          },
          {
            "name": "ITR A Complete",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_itr ), REMOVEFILTERS ( dim_date ), fact_itr[Stage] = \"A\",",
              "    NOT ISBLANK ( fact_itr[Completed_Date] ) )"
            ],
            "lineageTag": "0ba43f51-23ca-4021-9f81-1edc75c34a53",
            "formatString": "#,0"
          },
          {
            "name": "ITR A %",
            "expression": [
              "DIVIDE ( [ITR A Complete], [ITR A Total] )"
            ],
            "lineageTag": "aa0d482d-cdd7-4848-9b8c-7d5d2dcb615c",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "ITR B Total",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_itr ), REMOVEFILTERS ( dim_date ), fact_itr[Stage] = \"B\" )"
            ],
            "lineageTag": "2bc1a011-1906-461f-8312-d9c54ade27b9",
            "formatString": "#,0"
          },
          {
            "name": "ITR B Complete",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_itr ), REMOVEFILTERS ( dim_date ), fact_itr[Stage] = \"B\",",
              "    NOT ISBLANK ( fact_itr[Completed_Date] ) )"
            ],
            "lineageTag": "28312ec4-5bf7-4e94-9ff5-27736dbc6eba",
            "formatString": "#,0"
          },
          {
            "name": "ITR B %",
            "expression": [
              "DIVIDE ( [ITR B Complete], [ITR B Total] )"
            ],
            "lineageTag": "4b62e9b6-07d5-4348-b0cc-9c8a65ca77ea",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "ITR Planned (Cum)",
            "expression": [
              "VAR d = MAX ( dim_date[Date] )",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( fact_itr ), REMOVEFILTERS ( dim_date ), fact_itr[Planned_Date] <= d )"
            ],
            "lineageTag": "805c1bb3-b9a0-490c-80ad-cfb40640c7ee",
            "formatString": "#,0"
          },
          {
            "name": "ITR Completed (Cum)",
            "expression": [
              "VAR d = [Curve End Date]",
              "RETURN",
              "    IF (",
              "        MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE ( COUNTROWS ( fact_itr ), REMOVEFILTERS ( dim_date ), fact_itr[Completed_Date] <= d )",
              "    )"
            ],
            "lineageTag": "c7cecff4-6ca8-44cd-b76d-52d223a1882e",
            "formatString": "#,0"
          },
          {
            "name": "ITRs Behind Plan",
            "expression": [
              "VAR dd = [Data Date]",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( fact_itr ), REMOVEFILTERS ( dim_date ),",
              "        fact_itr[Planned_Date] <= dd, ISBLANK ( fact_itr[Completed_Date] ) )"
            ],
            "lineageTag": "1f4237a6-a6ed-4729-a328-f9981b237f5c",
            "formatString": "#,0"
          },
          {
            "name": "Punch Open",
            "expression": [
              "// open as of the axis date (burndown) or the data date (card)",
              "VAR d = [Curve End Date]",
              "RETURN",
              "    IF (",
              "        MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE (",
              "            COUNTROWS ( fact_punch ),",
              "            REMOVEFILTERS ( dim_date ),",
              "            fact_punch[Date_Raised] <= d,",
              "            ISBLANK ( fact_punch[Date_Cleared] ) || fact_punch[Date_Cleared] > d",
              "        )",
              "    )"
            ],
            "lineageTag": "e0b44df6-dbfc-4f6c-83ed-403ccd27e50b",
            "formatString": "#,0"
          },
          {
            "name": "Punch A Open",
            "expression": [
              "CALCULATE ( [Punch Open], fact_punch[Category] = \"A\" )"
            ],
            "lineageTag": "081c9f30-bf4f-44c6-b910-1b16a4247d61",
            "formatString": "#,0"
          },
          {
            "name": "Punch Raised",
            "expression": [
              "COUNTROWS ( fact_punch )"
            ],
            "lineageTag": "3a424d0d-d77c-4c88-a550-60ee68377a7e",
            "formatString": "#,0"
          },
          {
            "name": "Punch Cleared",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_punch ), USERELATIONSHIP ( fact_punch[Date_Cleared], dim_date[Date] ) )"
            ],
            "lineageTag": "db610509-0f67-44ff-ba54-f323fcc9c14b",
            "formatString": "#,0"
          },
          {
            "name": "Punch Overdue",
            "expression": [
              "VAR dd = [Data Date]",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( fact_punch ), REMOVEFILTERS ( dim_date ),",
              "        fact_punch[Status] = \"Open\", fact_punch[Target_Date] < dd )"
            ],
            "lineageTag": "9618e4a8-296a-45fc-84fc-79e7a49af2a8",
            "formatString": "#,0"
          },
          {
            "name": "Subsystems",
            "expression": [
              "COUNTROWS ( dim_subsystem )"
            ],
            "lineageTag": "77581867-4196-48b4-a3a2-7e8aafb0ddb0",
            "formatString": "#,0"
          },
          {
            "name": "MC Planned (Cum)",
            "expression": [
              "// dim_subsystem has no relationship to dim_date, so the axis date is applied directly",
              "VAR d = MAX ( dim_date[Date] )",
              "RETURN CALCULATE ( COUNTROWS ( dim_subsystem ), dim_subsystem[Planned_MC_Date] <= d )"
            ],
            "lineageTag": "32f41fea-65ca-4dc0-98c0-0a7c5fa65943",
            "formatString": "#,0"
          },
          {
            "name": "MC Actual (Cum)",
            "expression": [
              "VAR d = [Curve End Date]",
              "RETURN",
              "    IF ( MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE ( COUNTROWS ( dim_subsystem ), dim_subsystem[Actual_MC_Date] <= d ) )"
            ],
            "lineageTag": "47f1ab63-d0b3-4a7a-b493-98b73d91905e",
            "formatString": "#,0"
          },
          {
            "name": "Turnover Planned (Cum)",
            "expression": [
              "VAR d = MAX ( dim_date[Date] )",
              "RETURN CALCULATE ( COUNTROWS ( dim_subsystem ), dim_subsystem[Planned_Turnover_Date] <= d )"
            ],
            "lineageTag": "5e9af97c-d180-4d7c-b1b1-e6f231e6d214",
            "formatString": "#,0"
          },
          {
            "name": "Turnover Actual (Cum)",
            "expression": [
              "VAR d = [Curve End Date]",
              "RETURN",
              "    IF ( MIN ( dim_date[Date] ) <= [Data Date],",
              "        CALCULATE ( COUNTROWS ( dim_subsystem ), dim_subsystem[Actual_Turnover_Date] <= d ) )"
            ],
            "lineageTag": "f5e06d67-5175-47d9-9ff7-d21f2401c633",
            "formatString": "#,0"
          },
          {
            "name": "Subsystems Behind MC Plan",
            "expression": [
              "CALCULATE ( COUNTROWS ( dim_subsystem ), dim_subsystem[MC Status] = \"Behind Plan\" )"
            ],
            "lineageTag": "39a710af-9063-4d31-a23f-61a3a71db481",
            "formatString": "#,0"
          },
          {
            "name": "Subsystem Ready for MC",
            "expression": [
              "// for a subsystem table visual: all A sheets done and no open category A punch",
              "IF (",
              "    HASONEVALUE ( dim_subsystem[Subsystem_Code] ),",
              "    IF ( [ITR A %] = 1 && COALESCE ( [Punch A Open], 0 ) = 0, \"Ready\", \"Not Ready\" )",
              ")"
            ],
            "lineageTag": "5f7e8696-9d36-4b66-8005-65391127e5d2",
            "formatString": "#,0"
          },
          {
            "name": "Manhours",
            "expression": [
              "SUM ( fact_safety_weekly[Manhours] )"
            ],
            "lineageTag": "88b386af-b538-4130-bd95-1c6c143d00d2",
            "formatString": "#,0"
          },
          {
            "name": "Recordables",
            "expression": [
              "SUM ( fact_safety_weekly[Recordables] )"
            ],
            "lineageTag": "b9606ec2-b70d-462a-9560-a3fc1e9fc36c",
            "formatString": "#,0"
          },
          {
            "name": "TRIR",
            "expression": [
              "// total recordable incident rate per 200,000 hours (OSHA basis)",
              "DIVIDE ( [Recordables] * 200000, [Manhours] )"
            ],
            "lineageTag": "d7a8c498-baae-45fd-9cd2-057a733bfb84",
            "formatString": "0.00"
          },
          {
            "name": "LTIR",
            "expression": [
              "DIVIDE ( SUM ( fact_safety_weekly[Lost_Time_Injuries] ) * 200000, [Manhours] )"
            ],
            "lineageTag": "1664bb23-805b-4e52-8546-4a5ffc5953f9",
            "formatString": "0.00"
          },
          {
            "name": "TRIR Rolling 12M",
            "expression": [
              "CALCULATE ( [TRIR], DATESINPERIOD ( dim_date[Date], MAX ( dim_date[Date] ), -12, MONTH ) )"
            ],
            "lineageTag": "7cf9e493-10b0-48dc-af95-ba29676afdf8",
            "formatString": "0.00"
          },
          {
            "name": "Near Miss Ratio",
            "expression": [
              "// near misses reported per recordable (higher = stronger reporting culture)",
              "DIVIDE ( SUM ( fact_safety_weekly[Near_Misses] ), [Recordables] )"
            ],
            "lineageTag": "43f16b8a-19af-4d67-9558-df68e5a1f5f8",
            "formatString": "0.00"
          },
          {
            "name": "NCRs Raised",
            "expression": [
              "COUNTROWS ( fact_ncr )"
            ],
            "lineageTag": "8d102749-2908-45f3-8dd4-fa4991996601",
            "formatString": "#,0"
          },
          {
            "name": "NCRs Open",
            "expression": [
              "CALCULATE ( COUNTROWS ( fact_ncr ), REMOVEFILTERS ( dim_date ), fact_ncr[Status] = \"Open\" )"
            ],
            "lineageTag": "d948bff5-5817-46b6-9b2a-ab1d878be764",
            "formatString": "#,0"
          },
          {
            "name": "Avg Days to Close NCR",
            "expression": [
              "AVERAGEX (",
              "    FILTER ( fact_ncr, NOT ISBLANK ( fact_ncr[Date_Closed] ) ),",
              "    INT ( fact_ncr[Date_Closed] - fact_ncr[Date_Opened] )",
              ")"
            ],
            "lineageTag": "21bc1c9e-a118-4508-a910-de3a1c5f74de",
            "formatString": "#,0.0"
          }
        ]
      },
      {
        "name": "dim_date",
        "dataCategory": "Time",
        "lineageTag": "78cf2d5e-fc0a-4c5b-86d6-9f0f780fd915",
        "columns": [
          {
            "type": "calculatedTableColumn",
