          {
            "name": "TAT_Status",
            "dataType": "string",
            "type": "calculated",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    'Tests Release'[Completion_Date] < 'Tests Release'[Estimated_Completion_Date], \"Early\",",
              "    'Tests Release'[Completion_Date] = 'Tests Release'[Estimated_Completion_Date], \"On Time\",",
              "    'Tests Release'[Completion_Date] > 'Tests Release'[Estimated_Completion_Date], \"Late\",",
              "    \"Unknown\"",
              ")"
            ],
            "lineageTag": "79c9a57b-d30a-4e37-b1f9-f7f88fc3ac00",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          },
          {
            "name": "TAT_Variance",
            "dataType": "int64",
            "type": "calculated",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "DATEDIFF(",
              "    'Tests Release'[Completion_Date],",
              "    'Tests Release'[Estimated_Completion_Date],",
              "    DAY",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "049a8586-4c54-41e2-96ce-10dbf2d0233b",
            "summarizeBy": "sum",
            "annotations": [
