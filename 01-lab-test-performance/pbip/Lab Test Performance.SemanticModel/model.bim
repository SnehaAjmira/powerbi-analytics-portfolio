            "lineageTag": "775cadbc-4d41-4d50-8fdd-de33d7ff0b03"
          },
          {
            "name": "% Client Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [Client Count Change],",
              "    [Active Clients Prior Period],",
              "    0",
              ")"
            ],
            "formatString": "0%;-0%;0%",
            "displayFolder": "TAT Measures",
            "lineageTag": "54d12b8f-24a8-426c-a031-29b08b04631e"
          },
          {
            "name": "New Clients",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Tests Complete'[Client_Facility]),",
              "    FILTER(",
              "        VALUES('Tests Complete'[Client_Facility]),",
              "        CALCULATE(",
              "            COUNTROWS('Tests Complete'),",
              "            PREVIOUSMONTH('DimCalender'[Date])",
              "        ) = 0",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "1932bb4d-cce1-4a09-8b07-c49d17be00e4"
          },
          {
            "name": "Lost Clients",
