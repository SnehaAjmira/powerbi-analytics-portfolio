            ],
            "formatString": "0",
            "lineageTag": "f8f3d822-e2be-4b04-bb6e-9ba9d4ae1806"
          },
          {
            "name": "Analyte Volume Prior Period",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Tests Complete'),",
              "    PREVIOUSMONTH('DimCalender'[Date])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "6c714336-2194-4b14-9f36-415034bd73e0"
          },
          {
            "name": "Analyte Volume Change",
            "expression": [
              "",
