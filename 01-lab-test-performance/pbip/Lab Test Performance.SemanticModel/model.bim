      {
        "name": "_OOS Measures",
        "lineageTag": "0ed7da97-5a56-4c07-9308-a7614f439806",
        "isHidden": true,
        "columns": [
          {
            "name": "Value",
            "dataType": "int64",
            "type": "calculatedTableColumn",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Value]",
            "formatString": "0",
            "lineageTag": "0a2e07f5-6ff9-4045-b20f-b85f755253d8",
            "isHidden": true,
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "OOS Client Events",
            "expression": [
              "COUNTROWS(OosByClient)",
              ""
            ],
            "formatString": "0",
            "lineageTag": "7e0b0fef-eb2c-4cfe-9d63-8f92afe1d804",
            "isHidden": true
          },
          {
            "name": "OOS Client Rate",
            "expression": [
              "DIVIDE([OOS Client Events], [T.Tests Completed])",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "248ab578-3761-4c6f-8144-d2a7d0c8e753"
          },
          {
            "name": "Overall OOS Rate",
            "expression": [
              "CALCULATE([OOS Client Rate], ALLSELECTED())"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "540a0503-1a62-41dd-b56d-69633a3a0585"
          },
          {
            "name": "OOS Client Index",
            "expression": [
              "DIVIDE([OOS Client Rate], [OOS Client Rate])",
              ""
            ],
            "formatString": "0.00",
            "lineageTag": "7d8d2d3b-f0d3-4dbf-8df0-b0b67e0f147d"
          },
          {
            "name": "OOS Colour",
            "expression": [
              "SWITCH(TRUE(), [OOS Client Index] >= 1.5, \"#C00000\", [OOS Client Index] >= 1.1, \"#F4B183\", \"#7DBB91\")"
            ],
            "lineageTag": "56dc4fc6-43f7-4026-9856-b130cb583e08"
          },
          {
            "name": "OOS Tech Incidents",
            "expression": [
              "SUM(OosByTechnician[NumberOfOOS])",
              ""
            ],
            "formatString": "0",
            "lineageTag": "4d280abd-ae1a-435e-affd-eb7aec5560ba"
          },
          {
            "name": "OOS Client Clients Affected",
            "expression": [
              "DISTINCTCOUNT(OosByClient[ClientName])",
              ""
            ],
            "formatString": "0",
            "lineageTag": "208e867f-ef0b-4e7f-b308-6401891d2202"
          },
          {
            "name": "OOS Client Rate Trend",
            "expression": [
              "",
              "VAR FirstD = CALCULATE(MIN('Tests Complete'[Completion_Date]), ALLSELECTED())",
              "VAR LastD  = CALCULATE(MAX('Tests Complete'[Completion_Date]), ALLSELECTED())",
              "VAR R1 = CALCULATE([OOS Client Rate], DATESBETWEEN(DimCalender[Date], EOMONTH(FirstD,-1)+1, EOMONTH(FirstD,0)))",
              "VAR R2 = CALCULATE([OOS Client Rate], DATESBETWEEN(DimCalender[Date], EOMONTH(LastD,-1)+1, EOMONTH(LastD,0)))",
              "RETURN DIVIDE(R2 - R1, R1)"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "40417573-9540-445f-ab4f-f4634ad29e9c"
          },
          {
            "name": "OOS Tech Analysts Affected",
            "expression": [
              "DISTINCTCOUNT(OosByTechnician[Analyst])",
              ""
            ],
            "formatString": "0",
            "lineageTag": "83188b5d-db48-47c9-a7f6-7fa5635006ed"
          },
          {
            "name": "r Tests Completed vs OOS Client Rate",
            "expression": [
              "",
              "VAR t = FILTER(ADDCOLUMNS(VALUES(DimCalender[Month]), \"x\", [T.Tests Completed], \"y\", [OOS Client Rate]), NOT ISBLANK([x]))",
              "VAR mx = AVERAGEX(t, [x])  VAR my = AVERAGEX(t, [y])",
              "RETURN DIVIDE(SUMX(t, ([x]-mx)*([y]-my)), SQRT(SUMX(t, ([x]-mx)^2) * SUMX(t, ([y]-my)^2)))"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "d90dc300-052f-4ed7-9821-2188c9299a49"
          },
          {
            "name": "r OOS Tech vs OOS Client",
            "expression": [
              "",
              "VAR t = FILTER(ADDCOLUMNS(VALUES(DimCalender[Month]), \"x\", [OOS Tech Incidents], \"y\", [OOS Client Events]), NOT ISBLANK([x]))",
              "VAR mx = AVERAGEX(t, [x])  VAR my = AVERAGEX(t, [y])",
              "RETURN DIVIDE(SUMX(t, ([x]-mx)*([y]-my)), SQRT(SUMX(t, ([x]-mx)^2) * SUMX(t, ([y]-my)^2)))"
            ],
            "lineageTag": "f572be5d-8a79-4926-ae07-731c1d3a1ac9",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Past Due Rate",
            "expression": [
              "DIVIDE([Completed Late], [T.Tests Completed])",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "090a4915-6632-4071-97e3-8ba79b75f562"
          },
          {
            "name": "Lab Past Due Rate",
            "expression": [
              "CALCULATE([Past Due Rate], REMOVEFILTERS(DimClient), REMOVEFILTERS(DimAnalyte))"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "9a8aee61-542d-4f24-9461-e580817ccbdc"
          },
          {
            "name": "Past Due Index",
            "expression": [
              "DIVIDE([Past Due Rate], [Lab Past Due Rate])"
            ],
            "formatString": "0.00",
            "lineageTag": "fd8b8391-2bb7-48c5-b637-2d949d83a9e5"
          },
          {
            "name": "Tests Completed LM",
            "expression": [
              "CALCULATE([T.Tests Completed], DATEADD(DimCalender[Date], -1, MONTH))",
              ""
            ],
            "formatString": "0",
            "lineageTag": "7720c7c3-55ca-4a71-ae23-e52a391c842e"
          },
          {
            "name": "Past Due Rate LM",
            "expression": [
              "CALCULATE([Past Due Rate], DATEADD(DimCalender[Date], -1, MONTH))",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "28b3cadc-ef90-4f78-9f96-91672c0ebc59"
          },
          {
            "name": "OOS Client Events LM",
            "expression": [
              "CALCULATE([OOS Client Events], DATEADD(DimCalender[Date], -1, MONTH))",
              ""
            ],
            "formatString": "0",
            "lineageTag": "dfa8cb05-88fd-4e3a-a303-88bd47ab33af"
          },
          {
            "name": "OOS Client Rate LM",
            "expression": [
              "CALCULATE([OOS Client Rate], DATEADD(DimCalender[Date], -1, MONTH))",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "01c589af-5ed7-452f-8e66-6faf7c8497b9"
          },
          {
            "name": "OOS Tech Incidents LM",
            "expression": [
              "CALCULATE([OOS Tech Incidents], DATEADD(DimCalender[Date], -1, MONTH))",
              ""
            ],
            "formatString": "0",
            "lineageTag": "3c97df4a-c692-4e44-baa3-e116136c10d0"
          },
          {
            "name": "Tests Completed MoM Label",
            "expression": [
              "",
              "VAR d = DIVIDE([T.Tests Completed] - [Tests Completed LM], [Tests Completed LM])",
              "RETURN IF(d > 0, \"▲ \", IF(d < 0, \"▼ \", \"→ \")) & FORMAT(ABS(d), \"0.0%\") & \" | LM \" & FORMAT([Tests Completed LM], \"#,##0\")"
            ],
            "lineageTag": "57003691-b754-4d37-82e9-e7642dede3bb"
          },
          {
            "name": "Past Due MoM Label",
            "expression": [
              "",
              "VAR d = [Past Due Rate] - [Past Due Rate LM]",
              "RETURN IF(d > 0, \"▲ \", IF(d < 0, \"▼ \", \"→ \")) & FORMAT(ABS(d) * 100, \"0.00\") & \" pts | LM \" & FORMAT([Past Due Rate LM], \"0.0%\")"
            ],
            "lineageTag": "92c2d0d1-e9cd-49d4-a75b-36772a159189"
          },
          {
            "name": "OOS Client Events MoM Label",
            "expression": [
              "",
              "VAR d = DIVIDE([OOS Client Events] - [OOS Client Events LM], [OOS Client Events LM])",
              "RETURN IF(d > 0, \"▲ \", IF(d < 0, \"▼ \", \"→ \")) & FORMAT(ABS(d), \"0.0%\") & \" | LM \" & FORMAT([OOS Client Events LM], \"#,##0\")"
            ],
            "lineageTag": "4673998c-55ee-4f30-ad9f-36e2c526126d"
          },
          {
            "name": "OOS Client Rate MoM Label",
            "expression": [
              "",
              "VAR d = [OOS Client Rate] - [OOS Client Rate LM]",
              "RETURN IF(d > 0, \"▲ \", IF(d < 0, \"▼ \", \"→ \")) & FORMAT(ABS(d) * 100, \"0.00\") & \" pts | LM \" & FORMAT([OOS Client Rate LM], \"0.00%\")"
            ],
            "lineageTag": "b93d6bbd-6a45-4fae-8cf0-9884986f87b7"
          },
          {
            "name": "OOS Tech MoM Label",
            "expression": [
              "",
              "VAR d = DIVIDE([OOS Tech Incidents] - [OOS Tech Incidents LM], [OOS Tech Incidents LM])",
              "RETURN IF(d > 0, \"▲ \", IF(d < 0, \"▼ \", \"→ \")) & FORMAT(ABS(d), \"0.0%\") & \" | LM \" & FORMAT([OOS Tech Incidents LM], \"#,##0\")"
            ],
            "lineageTag": "a9c4f5da-f60e-4680-899c-e450d471deaa"
          },
          {
            "name": "Tests Completed MoM Colour",
            "expression": [
              "IF([T.Tests Completed] >= [Tests Completed LM], \"#2E7D32\", \"#C00000\")"
            ],
            "lineageTag": "f9744933-7505-40c6-87ba-260edaa41650"
          },
          {
            "name": "Past Due MoM Colour",
            "expression": [
              "IF([Past Due Rate] > [Past Due Rate LM], \"#C00000\", \"#2E7D32\")",
              ""
            ],
            "lineageTag": "c40e331d-d476-408c-8d52-89f6aa84fb64"
          },
          {
            "name": "OOS Client Events MoM Colour",
            "expression": [
              "IF([OOS Client Events] > [OOS Client Events LM], \"#C00000\", \"#2E7D32\")",
              ""
            ],
            "lineageTag": "ca8515dc-21ec-441f-a5ee-1fa7e7bead8c"
          },
          {
            "name": "OOS Client Rate MoM Colour",
            "expression": [
              "IF([OOS Client Rate] > [OOS Client Rate LM], \"#C00000\", \"#2E7D32\")",
              ""
            ],
            "lineageTag": "9a81b65c-e244-4907-8559-7737751b5704"
          },
          {
            "name": "OOS Tech MoM Colour",
            "expression": [
              "IF([OOS Tech Incidents] > [OOS Tech Incidents LM], \"#C00000\", \"#2E7D32\")",
              ""
            ],
            "lineageTag": "b045a74b-8fdd-4628-87ba-020805cb74a1"
          },
          {
            "name": "Client Volume Rank",
            "expression": [
              "IF(ISINSCOPE(DimClient[Client_Facility]),",
              "                      RANKX(ALLSELECTED(DimClient[Client_Facility]), [T.Tests Completed], , DESC, Dense))"
            ],
            "formatString": "0",
            "lineageTag": "8a4b3c5d-a254-4c19-8d15-ddc4553a8a42"
          },
          {
            "name": "Analyte Volume Rank",
            "expression": [
              "IF(ISINSCOPE(DimAnalyte[Analyte]),",
              "                      RANKX(ALLSELECTED(DimAnalyte[Analyte]), [T.Tests Completed], , DESC, Dense))"
            ],
            "formatString": "0",
            "lineageTag": "732c7f3c-12aa-4d91-809a-94049d165d61"
          },
          {
            "name": "Keep Review Flag",
            "expression": [
              "",
              "VAR n = [T.Tests Completed]",
              "RETURN SWITCH(TRUE(),",
              "    ISBLANK(n), BLANK(),",
              "    n < 50, \"Low Volume\",",
              "    [OOS Client Index] >= 2 && [Past Due Index] >= 1.2, \"Review\",",
              "    [OOS Client Index] >= 1.5 || [Past Due Index] >= 1.5, \"Watch\",",
              "    \"Keep\")"
            ],
            "lineageTag": "2a89169c-5394-49ff-b556-3a001e1c37a4"
          },
          {
            "name": "Flag Colour",
            "expression": [
              "SWITCH([Keep Review Flag], \"Review\",\"#C00000\", \"Watch\",\"#F4B183\", \"Keep\",\"#7DBB91\", \"#BFBFBF\")"
            ],
            "lineageTag": "0a2172d1-751a-4d9d-9de9-69d2c3df672f"
          },
          {
            "name": "Lab OOS Client Rate",
            "expression": [
              "CALCULATE([OOS Client Rate], REMOVEFILTERS(DimClient), REMOVEFILTERS(DimAnalyte))"
            ],
            "lineageTag": "fe5a315e-c3da-4152-9669-7de8ff3c7e0b",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Analyte Lab OOS Rate",
            "expression": [
              "CALCULATE([OOS Client Rate], REMOVEFILTERS(DimAnalyte), DimAnalyte[Analyte] <> \"\")"
            ],
            "lineageTag": "d9620cce-590b-4fb1-ae49-b9b35be07ad2",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Analyte Lab Past Due Rate",
            "expression": [
              "CALCULATE([Past Due Rate], REMOVEFILTERS(DimAnalyte), DimAnalyte[Analyte] <> \"\")"
            ],
            "lineageTag": "261d46f6-300b-4905-b80c-b047b9b5d559",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Analyte OOS Index",
            "expression": [
              "DIVIDE([OOS Client Rate], [Analyte Lab OOS Rate])"
            ],
            "lineageTag": "02ccf0bf-026d-4bc6-9cd5-d3a27f2fca7e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Analyte Past Due Index",
            "expression": [
              "DIVIDE([Past Due Rate], [Analyte Lab Past Due Rate])"
            ],
            "lineageTag": "d49c7287-1f07-4bc3-8ad9-16d8479de469",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Analyst OOS Rate",
            "expression": [
              "DIVIDE( [OOS Tech Incidents], [T.Tests Completed])"
            ],
            "lineageTag": "acf9007c-f380-4ffe-8cf2-e795442ff022",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
