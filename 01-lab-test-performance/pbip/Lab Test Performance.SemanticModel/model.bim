              "    PREVIOUSMONTH('DimCalender'[Date]),",
              "    FILTER(",
              "        VALUES('Tests Complete'[Client_Facility]),",
              "        CALCULATE(",
              "            COUNTROWS('Tests Complete')",
              "        ) = 0",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "fea71b14-a4e7-4591-82b9-e10dddd080f8"
          },
          {
            "name": "Total Analytes",
            "expression": [
