          {
            "name": "Avg TAT Variance",
            "expression": [
              "",
              "AVERAGE('Tests Complete'[TAT_Variance])"
            ],
            "displayFolder": "TAT Measures",
            "lineageTag": "eecb2f43-7553-4e66-8010-e10716eb850c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Released Not Completed",
            "expression": [
              "",
              "VAR ReleasedSubmissions =",
              "    CALCULATETABLE(",
              "        VALUES('Tests Release'[Submission_Number])",
              "    )",
              "VAR CompletedSubmissions =",
              "    CALCULATETABLE(",
              "        VALUES('Tests Complete'[Submission_Number])",
              "    )",
              "RETURN",
              "    COUNTROWS(",
              "        EXCEPT(ReleasedSubmissions, CompletedSubmissions)",
              "    )"
            ],
            "formatString": "0",
            "lineageTag": "d07c77e6-2fc3-4a48-96c1-0203288b9434"
          },
          {
            "name": "Completion Rate",
            "expression": [
              "",
              "DIVIDE(",
              "    [T.Tests Completed],",
              "    [T.Tests Released],",
              "    0",
              ")"
            ],
            "lineageTag": "65a22734-1ba5-49c8-80ba-9f68d2a42b74",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Late Rush Flag Breakdown",
            "expression": [
              "",
              "CALCULATE(",
              "    [Completed Late],",
              "    ALLEXCEPT('Tests Complete', 'Tests Complete'[Rush])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "823dae4b-f819-41b0-ab16-93845d5ddae0"
          },
          {
            "name": "Late by Test",
            "expression": [
              "",
              "CALCULATE(",
              "    [Completed Late],",
              "    ALLEXCEPT('Tests Complete', 'Tests Complete'[Test_Name])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "c68ef278-caa4-43c8-9f32-0d3af6186da9"
          },
          {
            "name": "Late by Facility Type",
            "expression": [
              "",
              "CALCULATE(",
              "    [Completed Late],",
              "    ALLEXCEPT('Tests Complete', 'Tests Complete'[Facility_Type])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "01e482a5-0eac-4179-bce4-289ac998a778"
          },
          {
            "name": "Total Lot Numbers",
            "expression": [
              "",
              "DISTINCTCOUNT('Tests Complete'[Lot_Number])"
            ],
            "formatString": "0",
            "lineageTag": "0874aec1-571e-4a46-a24c-5fdb1b6fae34"
          },
          {
            "name": "Lot Numbers Prior Period",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Tests Complete'[Lot_Number]),",
              "    PREVIOUSMONTH('DimCalender'[Date])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "d65f9994-47a3-41b4-9c92-e95832c6387d"
          },
          {
            "name": "Lot Number Change",
            "expression": [
              "",
              "[Total Lot Numbers] - [Lot Numbers Prior Period]"
            ],
            "formatString": "0",
            "lineageTag": "00d95736-f184-42f9-894d-7364b3bc16be"
          },
          {
            "name": "% Lot Number Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [Lot Number Change],",
              "    [Lot Numbers Prior Period],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "1663ce48-4bbd-4236-8f5a-533373beab51"
          },
          {
            "name": "Lots With Late Tests",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Tests Complete'[Lot_Number]),",
              "    'Tests Complete'[TAT_Status] = \"Late\"",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "c851a8c4-0b74-4603-8336-bfbbec0ed61c"
          },
          {
            "name": "% Lots With Late Tests",
            "expression": [
              "",
              "DIVIDE(",
              "    [Lots With Late Tests],",
              "    [Total Lot Numbers],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "91b3b012-774f-4fb5-9e61-ad14a24725ae"
          },
          {
            "name": "Completion Variance",
            "expression": [
              "[T.Tests Completed] - [T.Tests Released]"
            ],
            "formatString": "0",
            "lineageTag": "c501e5c3-5946-4bee-a3e7-bf16f26e99f2"
          },
          {
            "name": "Completion Variance %",
            "expression": [
              "",
              "DIVIDE([T.Tests Completed] - [T.Tests Released], [T.Tests Released])"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "3725723c-59fd-455a-b410-107c9de1d935"
          },
          {
            "name": "Completion Variance Indicator",
            "expression": [
              "",
              "VAR rel = [T.Tests Released]",
              "VAR comp = [T.Tests Completed]",
              "VAR pct = [Completion Variance %]",
              "RETURN",
              "    IF(",
              "        ISBLANK(rel) && ISBLANK(comp),",
              "        BLANK(),",
              "        SWITCH(",
              "            TRUE(),",
              "            ISBLANK(pct), \"—\",",
              "            pct = 0, \"—\",",
              "            pct > 0, \"▲ \" & FORMAT(pct, \"0.0%\"),",
              "            \"▼ \" & FORMAT(pct, \"0.0%\")",
              "        )",
              "    )"
            ],
            "lineageTag": "9f5983dd-d4b8-48dd-85f5-0633cc4f6d14"
          },
          {
            "name": "Completion Variance Color",
            "expression": [
              "",
              "VAR pct = [Completion Variance %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(pct) || pct = 0, \"#808080\",",
              "        pct > 0, \"#2E7D32\",   -- green: completed more than released (working down backlog)",
              "        \"#D32F2F\"             -- red/orange: completed less than released (backlog growing)",
              "    )"
            ],
            "lineageTag": "83e7a3a1-422d-463f-b11c-858e75eb4637"
          },
          {
            "name": "Min TAT Days",
            "expression": [
              "MIN('Tests Complete'[TAT_Days])"
            ],
            "formatString": "0",
            "displayFolder": "TAT Measures",
            "lineageTag": "a5caa902-cf34-4a24-acca-2f73d6681273"
          },
          {
            "name": "Max TAT Days",
            "expression": [
              "MAX('Tests Complete'[TAT_Days])"
            ],
            "formatString": "0",
            "displayFolder": "TAT Measures",
            "lineageTag": "b24c01db-4265-4b53-a74c-1f2c29f7bcb3"
          },
          {
            "name": "TAT Days StdDev",
            "expression": [
              "STDEV.P('Tests Complete'[TAT_Days])"
            ],
            "displayFolder": "TAT Measures",
            "lineageTag": "4ae50b2e-8cac-4836-baff-acb32967f288",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Avg TAT Days On Time",
            "expression": [
              "CALCULATE(AVERAGE('Tests Complete'[TAT_Days]), 'Tests Complete'[TAT_Status] = \"On Time\")"
            ],
            "displayFolder": "TAT Measures",
            "lineageTag": "786d0d1d-bfe8-4f45-9de2-bad0546baed5",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Avg. Price",
            "expression": [
