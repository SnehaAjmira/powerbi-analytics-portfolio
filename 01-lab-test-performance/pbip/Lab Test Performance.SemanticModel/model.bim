                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Last Update",
            "expression": [
              "MAX('Tests Release'[Completion_Date])"
            ],
            "formatString": "General Date",
            "lineageTag": "25d8ab52-0b77-4c00-985c-c0f8692b3414"
          },
          {
            "name": "Released Prior Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [T.Tests Released],",
              "    PREVIOUSMONTH('DimCalender'[Date])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "9d59f9d8-1176-4c9e-9af6-526ed634b5e8"
          },
          {
            "name": "Released MoM Change",
            "expression": [
              "[T.Tests Released] - [Released Prior Month]"
            ],
            "formatString": "0",
            "lineageTag": "0e1ca94b-33f9-4747-a6ca-2fb5563ec409"
          },
          {
            "name": "Released MoM %",
            "expression": [
              "DIVIDE([Released MoM Change], [Released Prior Month], 0)"
            ],
            "lineageTag": "9cba3bae-facc-49f1-8439-f4b50bfec2dd",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Analyst Tests Completed Prior Month",
            "expression": [
              "",
              "CALCULATE([T.Tests Completed] , DATEADD('DimCalender'[Date], -1, MONTH))"
            ],
            "lineageTag": "c022070c-00e7-406d-99b7-5a666f3db26f",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Analyst MoM Variance %",
            "expression": [
              "",
              "DIVIDE(",
              "    [T.Tests Completed] - [Analyst Tests Completed Prior Month],",
              "    [Analyst Tests Completed Prior Month],",
              "    0",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "lineageTag": "6b992102-9323-49f7-b19e-715bbc1c39f4"
          },
          {
            "name": "Analyst Growth Label",
            "expression": [
              "",
              "VAR pct = [Analyst MoM Variance %]",
              "VAR avgPct = [Overall Avg Analyst MoM Variance %]",
              "VAR diff = pct - avgPct",
              "RETURN",
              "    IF(",
              "        ISINSCOPE('DimCalender'[Month]),",
              "        BLANK(),",
              "        SWITCH(",
              "            TRUE(),",
              "            ISBLANK(pct) || pct = 0, \"No Prior Data\",",
              "            diff > 0.02, \"Growing\",",
              "            diff < -0.02, \"Below Average\",",
              "            \"Stable\"",
              "        )",
              "    )"
            ],
            "lineageTag": "ecfafd6b-2fc4-4cde-8964-2bf4a2e64807"
          },
          {
            "name": "Analyst MoM Indicator",
            "expression": [
              "",
              "VAR prior = [Analyst Tests Completed Prior Month]",
              "VAR curr = [T.Tests Completed]",
              "VAR pct = [Analyst MoM Variance %]",
              "RETURN",
              "    IF(",
              "        ISBLANK(prior) && ISBLANK(curr),",
              "        BLANK(),",
              "        SWITCH(",
              "            TRUE(),",
              "            ISBLANK(pct), \"—\",",
              "            pct = 0, \"—\",",
              "            pct > 0, \"▲ \" & FORMAT(pct, \"0.0%\"),",
              "            \"▼ \" & FORMAT(pct, \"0.0%\")",
              "        )",
              "    )"
            ],
            "lineageTag": "d28e32ad-640e-463f-b184-af7d97b64e04"
          },
          {
            "name": "Analyst MoM Color",
            "expression": [
              "",
              "VAR pct = [Analyst MoM Variance %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        ISBLANK(pct) || pct = 0, \"#808080\",",
              "        pct > 0, \"#2E7D32\",",
              "        \"#D32F2F\"",
              "    )"
            ],
            "lineageTag": "7243a8d4-2610-4ccc-a8a1-4c33b199ef6e"
          },
          {
            "name": "Overall Avg Analyst MoM Variance %",
            "expression": [
              "",
              "AVERAGEX(ALLSELECTED('DimAnalyst'[Analyst]), [Analyst MoM Variance %])",
              ""
            ],
            "lineageTag": "2fe4a474-d308-445e-80d4-768fb993dacd",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          }
        ],
