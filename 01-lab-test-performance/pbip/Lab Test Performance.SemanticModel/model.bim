            ],
            "formatString": "0",
            "lineageTag": "94eba220-8e20-4d64-9518-2666d54461ac"
          },
          {
            "name": "Top Analyte",
            "expression": [
              "",
              "CALCULATE(",
              "    FIRSTNONBLANK('Tests Complete'[Analyte], 1),",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE(",
              "            'Tests Complete',",
              "            'Tests Complete'[Analyte],",
              "            \"Vol\", COUNTROWS('Tests Complete')",
              "        ),",
              "        [Vol],",
              "        DESC",
              "    )",
              ")"
            ],
            "lineageTag": "de14473f-d458-4783-93d2-57c003ab1f54"
