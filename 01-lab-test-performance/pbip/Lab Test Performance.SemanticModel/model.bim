        "measures": [
          {
            "name": "QA Total Approvals",
            "expression": [
              "",
              "COUNTROWS('Quality Data')"
            ],
            "formatString": "0",
            "lineageTag": "8983ac28-3ffe-4789-b111-82ef48884e0e"
          },
          {
            "name": "QA Distinct Clients",
            "expression": [
              "",
              "DISTINCTCOUNT('Quality Data'[Client_Name])"
            ],
            "formatString": "0",
            "lineageTag": "d6b0d656-f47c-43e5-a5f3-65b923485716"
          },
          {
            "name": "QA Distinct Test Types",
            "expression": [
              "",
              "DISTINCTCOUNT('Quality Data'[Test_Name])"
            ],
            "formatString": "0",
            "lineageTag": "8c148c2e-e91a-47b7-9ce0-dee23fa8e8b1"
          },
          {
            "name": "QA Avg Approvals Per Day",
            "expression": [
              "",
              "DIVIDE(",
              "    COUNTROWS('Quality Data'),",
              "    DISTINCTCOUNT('Quality Data'[Approval_Date]),",
              "    0",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "082f72dc-2083-4403-870d-81b0784254bc"
          },
          {
            "name": "QA Avg Per Approver Per Day",
            "expression": [
              "",
              "DIVIDE(",
              "    COUNTROWS('Quality Data'),",
              "    DISTINCTCOUNT('Quality Data'[Approved_By])",
              "        * DISTINCTCOUNT('Quality Data'[Completed]),",
              "    0",
              ")"
            ],
            "lineageTag": "49fea66b-67e2-428b-875c-671dcd0d4377",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "QA Approvals Prior Month",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Quality Data'),",
              "    PREVIOUSMONTH('DimCalender'[Date])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "5c4f9238-e3c6-4d55-ac52-882197ddb141"
          },
          {
            "name": "QA Approvals Change",
            "expression": [
              "",
              "[QA Total Approvals] - [QA Approvals Prior Month]"
            ],
            "formatString": "0",
            "lineageTag": "4904a3db-b694-4156-9abc-acc5294840b7"
          },
          {
            "name": "QA Approvals % Change",
            "expression": [
              "",
              "DIVIDE(",
              "    [QA Approvals Change],",
              "    [QA Approvals Prior Month],",
              "    0",
              ")"
            ],
            "lineageTag": "e0e830a1-771f-4dcc-8cf9-d149eb36e456",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "QA Approvals SPLY",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Quality Data'),",
              "    SAMEPERIODLASTYEAR('DimCalender'[Date])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "545a5a12-0e9b-405d-b735-d43d0f7224d8"
          },
          {
            "name": "QA Approvals YOY %",
            "expression": [
              "",
              "DIVIDE(",
              "    [QA Total Approvals] - [QA Approvals SPLY],",
              "    [QA Approvals SPLY],",
              "    0",
              ")"
            ],
            "lineageTag": "7320d854-2016-4c9f-9990-eb02c5ec1da1",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "QA Approvals QTD",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Quality Data'),",
              "    DATESQTD('DimCalender'[Date])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "dec4bee7-826d-40c2-9280-f7b242f83b4d"
          },
          {
            "name": "QA Approvals By Approver",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Quality Data'),",
              "    ALLEXCEPT('Quality Data', 'Quality Data'[Approved_By])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "7fc93ca4-e25c-4e38-92d6-0070dea536ff"
          },
          {
            "name": "QA Approvals By Department",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Quality Data'),",
              "    ALLEXCEPT('Quality Data', 'Quality Data'[Department])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "463afd95-65c6-4079-915f-e26e5bc3121a"
          },
          {
            "name": "QA Approvals By Facility Type",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Quality Data'),",
              "    ALLEXCEPT('Quality Data', 'Quality Data'[Facility_Type])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "84ed8951-289f-42dd-ae43-d08fdbfce390"
          }
        ],
        "partitions": [
          {
            "name": "Quality Data",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "  Source = Excel.Workbook(File.Contents(DataFolder & \"Quality Data.xlsx\"), null, true),",
                "  #\"Navigation 1\" = Source{[Item = \"Quality Data\", Kind = \"Sheet\"]}[Data],",
                "  #\"Promoted headers\" = Table.PromoteHeaders(#\"Navigation 1\", [PromoteAllScalars = true]),",
                "  #\"Changed column type\" = Table.TransformColumnTypes(#\"Promoted headers\", {{\"Submission\", type text}, {\"Test_Name\", type text}, {\"Department\", type text}, {\"Dosage_Form\", type text}, {\"Analyst\", type text}, {\"Client_Name\", type text}, {\"Facility_Type\", type text}, {\"Time_In_Sample_Prep\", type number}, {\"Time_In_Sample_Analysis\", type number}, {\"Time_In_Data_Processing\", type number}, {\"Time_In_Data_Review\", type number}, {\"Time_In_On_Hold\", type number}, {\"Time_In_Approved\", Int64.Type}, {\"Time_In_Qa_Review\", type number}, {\"Time_In_Qa_Hold\", type number}, {\"Time_In_Qa_Approved\", Int64.Type}, {\"Time_To_Complete\", type number}, {\"Completed\", type datetime}, {\"Approved_By\", type text}})",
                "in",
                "  #\"Changed column type\""
              ]
            },
            "mode": "import"
          }
        ],
