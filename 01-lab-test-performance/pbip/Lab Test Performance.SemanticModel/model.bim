              "DIVIDE(",
              "    [Rush Completed],",
              "    [T.Tests Completed],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "d1b55416-cea9-4739-be1d-67df431b167e"
          },
          {
            "name": "Active Clients",
            "expression": [
