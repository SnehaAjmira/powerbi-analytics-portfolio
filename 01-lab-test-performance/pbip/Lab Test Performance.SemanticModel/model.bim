          {
            "name": "TAT_Variance",
            "dataType": "int64",
            "type": "calculated",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "DATEDIFF(",
              "    'Tests Complete'[Completion_Date],",
              "    'Tests Complete'[Estimated_Completion_Date],",
              "    DAY",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "ab8cfdee-bd0d-4039-99c1-31661f785ed1",
