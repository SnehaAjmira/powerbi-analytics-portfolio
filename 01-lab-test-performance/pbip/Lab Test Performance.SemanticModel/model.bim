            ],
            "formatString": "0",
            "lineageTag": "858c1016-da98-424e-a83d-30c048b036f7"
          },
          {
            "name": "Active Clients Prior Period",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Tests Complete'[Client_Facility]),",
              "    PREVIOUSMONTH('DimCalender'[Date])",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "1f76bcd1-386d-4d09-a5d8-65894f66ba67"
          },
          {
            "name": "Client Count Change",
