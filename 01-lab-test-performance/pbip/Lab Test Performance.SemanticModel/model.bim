        "measures": [
          {
            "name": "Client Rank",
            "expression": [
              "",
              "IF(",
              "    ISBLANK([T.Tests Completed]),",
              "    BLANK(),",
              "    RANKX(",
              "        ALLSELECTED(DimClient[Client_Facility]),",
              "        CALCULATE([T.Tests Completed], ALL(DimCalender)),",
              "        ,",
              "        DESC,",
              "        Dense",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "b56db94c-515e-4fd4-946b-fc46f235a532"
          }
        ],
