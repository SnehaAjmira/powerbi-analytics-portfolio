        "partitions": [
          {
            "name": "DimCalender",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "ADDCOLUMNS(",
                "    CALENDAR(DATE(2024,1,1), DATE(2026,12,31)),",
                "    \"Year\", YEAR([Date]),",
                "    \"Month\", FORMAT([Date], \"MMM\"),",
                "    \"Quarter\", FORMAT([Date], \"Q\"),",
                "    \"Week\", WEEKNUM([Date]))"
              ]
            },
            "mode": "import"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "c7fa9e5c56b14daeba512d43fefa418c"
          }
        ]
