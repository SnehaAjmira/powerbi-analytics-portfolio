                                ORDERBY([Total Revenue], DESC)
                            )
                        )
                    VAR Th = selectedPareto
                    RETURN RT <= Th && 'Client split category'[Category] = "A+"
                ),
                [Test]
            )
        RETURN
            CALCULATE([Total Revenue], Tble)

