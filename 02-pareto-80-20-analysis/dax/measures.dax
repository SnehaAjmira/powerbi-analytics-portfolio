                    "Total Revenue " & FORMAT(
                        CALCULATE(
                            [Total Revenue],
                            Tble
                        ), "$0.0"
                    ) & " | " & COUNTROWS(Tble) & " Tests Rev"
                )
        )

    MEASURE 'AllData'[Total Test Types] =
        DISTINCTCOUNT(AllData[Test_Name])

    MEASURE 'AllData'[Client Vol RT Split] =
        SWITCH(
            TRUE(),
            SELECTEDVALUE('Client split category'[Category])= "A+" &&
            [Client Vol Contrib Run Total] <= [Pareto Value],
            [Client Vol Contrib Run Total],
        
            SELECTEDVALUE('Client split category'[Category]) = "Others" &&
            [Client Vol Contrib Run Total] > [Pareto Value],
            [Client Vol Contrib Run Total]
        )

    MEASURE 'AllData'[Client Vol Test] =
        IF(
            ISINSCOPE( 'Client split category'[Client]), 
            BLANK(),
            COUNTROWS(
                FILTER(
                    SUMMARIZE(
                        'Client split category','Client split category'[Client], 'Client split category'[Category],
                        "Client Vol Test",
                            VAR RT = 
                             CALCULATE(
                                DIVIDE(
                                    [Total Test Volume],
                                    CALCULATE(
                                        CALCULATE(
                                            [Total Test Volume],
                                            ALLEXCEPT('Client split category', 'Client split category'[Category])
                                        ),
                                        KEEPFILTERS('Client split category'[Client])
                                    )
                                ),
                                WINDOW(
                                    1, ABS,
                                    0, REL, 
                                    ALLEXCEPT('Client split category', 'Client split category'[Category]),
                                    ORDERBY([Total Test Volume], DESC)
                                )
                            )
                            VAR Th = [Pareto Value]
                    RETURN
                            RT <= Th && 'Client split category'[Category] = "A+"
                        ), 
                    [Client Vol]
                )
             )
        )

    MEASURE 'AllData'[A+ Client Count (Rev)] =
        VAR selectedPareto = SELECTEDVALUE(Parameter[Parameter])
        VAR Tble =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE(
                        'Client split category',
                        'Client split category'[Client],
                        'Client split category'[Category]
                    ),
                    "Test",
                    VAR RT =
                        CALCULATE (
                            DIVIDE (
                                [Total Revenue],
                                CALCULATE(
                                    [Total Revenue],
                                    ALL('Client split category'[Client])
                                )
                            ),
                            WINDOW (
                                1, ABS,
                                0, REL,
                                ALL('Client split category'[Client]),
                                ORDERBY([Total Revenue], DESC)
                            )
                        )
                    VAR Th = selectedPareto
                    RETURN RT <= Th && 'Client split category'[Category] = "A+"
                ),
                [Test]
            )
        RETURN
            COUNTROWS(Tble)

    MEASURE 'AllData'[A+ Clients % (Rev) - work on this] =
        VAR selectedPareto = SELECTEDVALUE(Parameter[Parameter])
        -- Get all active clients (regardless of calendar filter!)
        VAR AllActiveClients =
            CALCULATE(
                DISTINCTCOUNT('AllData'[Client_Facility]),
                REMOVEFILTERS(DimCalendar)
            )
        -- Find Pareto A+ clients (based on criteria and mapping from split category)
        VAR ParetoAPlusClients =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE(
                        'AllData',
                        'AllData'[Client_Facility]
                    ),
                    "IsAPlusPareto",
                    VAR ClientCategory =
                        LOOKUPVALUE(
                            'Client split category'[Category],
                            'Client split category'[Client],
                            'AllData'[Client_Facility]
                        )
                    VAR RT =
                        CALCULATE (
                            DIVIDE (
                                [Total Revenue],
                                CALCULATE(
                                    [Total Revenue],
                                    ALL('AllData'[Client_Facility])
                                )
                            ),
                            WINDOW (
                                1, ABS,
                                0, REL,
                                ALL('AllData'[Client_Facility]),
                                ORDERBY([Total Revenue], DESC)
                            )
                        )
                    RETURN RT <= selectedPareto && ClientCategory = "A+"
                ),
                [IsAPlusPareto]
            )
        VAR APlusCount = COUNTROWS(ParetoAPlusClients)
        RETURN
            DIVIDE(APlusCount, AllActiveClients) * 100

    MEASURE 'AllData'[Total Clients] =
        CALCULATE(
                DISTINCTCOUNT(AllData[Client_Facility]))

    MEASURE 'AllData'[A+ Clients Total Revenue] =
        VAR selectedPareto = SELECTEDVALUE(Parameter[Parameter])
        VAR Tble =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE(
                        'Client split category',
                        'Client split category'[Client],
                        'Client split category'[Category]
                    ),
                    "Test",
                    VAR RT =
                        CALCULATE (
                            DIVIDE (
                                [Total Revenue],
                                CALCULATE(
                                    [Total Revenue],
                                    ALL('Client split category'[Client])
                                )
                            ),
