        VAR Tble =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE(
                        'Test split category',
                        'Test split category'[Tests],
                        'Test split category'[Category]
                    ),
                    "Test",
                    VAR RT =
                        CALCULATE (
                            DIVIDE (
                                [Total Test Volume],
                                CALCULATE(
                                    [Total Test Volume],
                                    ALL('Test split category'[Tests])
                                )
                            ),
                            WINDOW (
                                1, ABS,
                                0, REL,
                                ALL('Test split category'[Tests]),
                                ORDERBY([Total Test Volume], DESC)
                            )
                        )
                    VAR Th = selectedPareto
                    RETURN RT <= Th && 'Test split category'[Category] = "A+"
                ),
                [Test]
            )
        RETURN
            CALCULATE([Total Test Volume], Tble)

EVALUATE { 1 }