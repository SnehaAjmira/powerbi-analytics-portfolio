                    CALCULATE(
                        [Total Test Volume],
                        tble
                    ) <> BLANK(),
                    "Total Test Vol " & FORMAT(
                        CALCULATE(
                            [Total Test Volume],
                            Tble
                        ), "$0.0"
                    ) & " | " & COUNTROWS(Tble) & " Test Vol"
                )
        )

    MEASURE 'AllData'[Test Vol Contrib %] =
        If(
            [Total Test Volume],
                DIVIDE(
                [Total Test Volume],
                [Test Vol Denom]
            )
        )

    MEASURE 'AllData'[Test Vol Contrib Run Total] =
        IF(
