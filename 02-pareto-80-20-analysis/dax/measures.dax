            CALCULATE(
                [Test Vol Contrib %],
                WINDOW(
                    1, ABS,
                    0, REL,
                    ALL('Test split category'[Tests]),
                    ORDERBY([Total Test Volume], DESC)
                )
            )
        )

    MEASURE 'AllData'[Test Vol Cum. %] =
        IF(
            [Total Test Volume],
            CALCULATE(
                [Test Vol Contrib %],
                WINDOW(
                    1, ABS,
                    0, REL, 
                    ALL('Test split category'[Tests]),
                    ORDERBY([Total Test Volume], DESC)
                )
            )
        )

    MEASURE 'AllData'[Test Vol Denom] =
        CALCULATE(
            [Total Test Volume],
            REMOVEFILTERS('Test split category'[Tests])
        )

    MEASURE 'AllData'[Test Vol Rank] =
        IF(
            [Total Test Volume],
            RANKX(
                ALL('Test split category'[Tests]),
                [Total Test Volume],,
                DESC,Dense
            )
        )

    MEASURE 'AllData'[Test Vol RT Split] =
        SWITCH(
            TRUE(),
            SELECTEDVALUE('Test split category'[Category])= "A+" &&
            [Test Vol Contrib Run Total] <= [Pareto Value],
            [Test Vol Contrib Run Total],
        
            SELECTEDVALUE('Test split category'[Category]) = "Others" &&
            [Test Vol Contrib Run Total] > [Pareto Value],
            [Test Vol Contrib Run Total]
        )

    MEASURE 'AllData'[Test Vol Run Total] =
        CALCULATE(
            [Total Test Volume],
            WINDOW(
                1,ABS,
                0,REL,
                ALLSELECTED('Test split category'[Tests]),
                ORDERBY([Total Test Volume], DESC)
        ))

    MEASURE 'AllData'[Test's Vol] =
        IF(
            ISINSCOPE( 'Test split category'[Tests]), 
            BLANK(),
            COUNTROWS(
                FILTER(
                    SUMMARIZE(
                        'Test split category','Test split category'[Tests], 'Test split category'[Category],
                        "Test's Vol",
                            VAR RT = 
                             CALCULATE(
                                DIVIDE(
                                    [Total Test Volume],
                                    CALCULATE(
                                        CALCULATE(
                                            [Total Test Volume],
                                            ALLEXCEPT('Test split category', 'Test split category'[Category])
                                        ),
                                        KEEPFILTERS('Test split category'[Tests])
                                    )
                                ),
                                WINDOW(
                                    1, ABS,
                                    0, REL, 
                                    ALLEXCEPT('Test split category', 'Test split category'[Category]),
                                    ORDERBY([Total Test Volume], DESC)
                                )
                            )
                            VAR Th = [Pareto Value]
                    RETURN
                            RT <= Th && 'Test split category'[Category] = "A+"
                        ), 
                    [Test's Vol]
                )
             )
        )

    MEASURE 'AllData'[Tests Rev] =
        IF(
            [Total Revenue] && ISINSCOPE('Test split category'[Tests]),
            SELECTEDVALUE('Test split category'[Tests]),        
            VAR Tble = 
                FILTER(
                    ADDCOLUMNS(
                        SUMMARIZE('Test split category','Test split category'[Tests], 'Test split category'[Category]),
                        "Test Test",
                            VAR RT = 
                            CALCULATE(
                                DIVIDE(
                                    [Total Revenue],
                                    CALCULATE(
                                        [Total Revenue],
                                        ALL('Test split category'[Tests])
                                    )
                                ),
                                WINDOW(
                                    1, ABS,
                                    0, REL, 
                                    ALL('Test split category'[Tests]),
                                    ORDERBY([Total Revenue], DESC)
                                )
                            )
                            VAR Th = [Pareto Value]
                    RETURN
