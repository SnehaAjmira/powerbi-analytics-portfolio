    MEASURE 'AllData'[A+ Tests Total Revenue] =
        VAR selectedPareto = SELECTEDVALUE(Parameter[Parameter])
        VAR Tble =
            FILTER (
                ADDCOLUMNS (
                    SUMMARIZE(
                        'Test split category',
                        'Test split category'[Tests],
