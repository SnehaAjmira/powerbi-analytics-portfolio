          {
            "name": "Client Rev Contrib %",
            "expression": [
              "",
              "If(",
              "    [Total Revenue],",
              "        DIVIDE(",
              "        [Total Revenue],",
              "        [Client Rev Denom]",
              "    )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Client Pareto",
            "lineageTag": "5a05b6f2-86c9-4c41-9dae-16ea64c43f6f"
          },
          {
            "name": "Client Rev",
            "expression": [
              "",
              "IF(",
              "    [Total Revenue] && ISINSCOPE('Client split category'[Client]),",
              "    SELECTEDVALUE('Client split category'[Client]),        ",
              "    VAR Tble = ",
              "        FILTER(",
              "            ADDCOLUMNS(",
              "                SUMMARIZE('Client split category','Client split category'[Client], 'Client split category'[Category]),",
              "                \"Test\",",
              "                    VAR RT = ",
              "                    CALCULATE(",
              "                        DIVIDE(",
              "                            [Total Revenue],",
              "                            CALCULATE(",
              "                                [Total Revenue],",
              "                                ALL('Client split category'[Client])",
              "                            )",
              "                        ),",
              "                        WINDOW(",
              "                            1, ABS,",
              "                            0, REL, ",
              "                            ALL('Client split category'[Client]),",
              "                            ORDERBY([Total Revenue], DESC)",
              "                        )",
              "                    )",
              "                    VAR Th = [Pareto Value]",
              "            RETURN",
              "                    RT <= Th && 'Client split category'[Category] = \"A+\"",
              "                ), ",
              "            [Test]",
              "        )",
              "    RETURN",
              "        IF(",
              "            CALCULATE(",
              "                [Total Revenue],",
              "                tble",
              "            ) <> BLANK(),",
              "            \"Total Revenue \" & FORMAT(",
              "                CALCULATE(",
              "                    [Total Revenue],",
              "                    Tble",
              "                ), \"$0.0\"",
              "            ) & \" | \" & COUNTROWS(Tble) & \" Clients\"",
              "        )",
              ")"
            ],
            "displayFolder": "Client Pareto",
            "lineageTag": "336b2ebf-52f3-42c3-bdc3-883a404934a5",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
