      {
        "name": "Client Vol Metrics",
        "lineageTag": "cef51806-138b-450d-bb7d-0d4d5f43ba0e",
        "calculationGroup": {
          "precedence": 0,
          "calculationItems": [
            {
              "name": "Client Vol Metrics",
              "expression": [
                "",
                "IF(",
                "    ISINSCOPE('Client split category'[Client]),",
                "    SWITCH(",
                "        TRUE(),",
                "        SELECTEDVALUE('Client split category'[Category]) = \"A+\" && [Client Vol Cum. %] <= [Pareto Value], SELECTEDMEASURE(),",
                "        SELECTEDVALUE('Client split category'[Category]) = \"Others\" && [Client Vol Cum. %] > [Pareto Value], SELECTEDMEASURE(),",
                "        TRUE(), BLANK()",
                "    ),",
                "    IF(",
                "        ISSELECTEDMEASURE([Client Vol]),",
                "        SELECTEDMEASURE()",
                "    )",
                ")"
              ],
              "ordinal": -1
            }
