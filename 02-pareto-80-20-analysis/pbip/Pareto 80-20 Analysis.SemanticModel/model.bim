        "partitions": [
          {
            "name": "DimCalendar",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "ADDCOLUMNS(",
                "    CALENDAR(DATE(2020,1,1), DATE(2026,12,31)),",
                "    \"Year\", YEAR([Date]),",
                "    \"Month\", FORMAT([Date], \"MMMM\"),",
                "    \"Quarter\", \"Q\" & FORMAT([Date], \"Q\"),",
                "    \"Week\", WEEKNUM([Date])",
                ")"
              ]
            },
            "mode": "import"
          }
        ],
