        "measures": [
          {
            "name": "Total Revenue",
            "expression": [
              "CALCULATE(SUM(AllData[Price]))"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "displayFolder": "Client Pareto",
            "lineageTag": "54da193d-5cb3-4a21-87d5-8d2bf68b246f",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Client Vol Run Total",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Test Volume],",
              "    WINDOW(",
              "        1,ABS,",
              "        0,REL,",
              "        ALLSELECTED('Client split category'[Client]),",
              "        ORDERBY([Total Test Volume], DESC)",
              "))"
            ],
            "displayFolder": "Client Pareto",
            "lineageTag": "d4374062-899e-480f-9307-3eef091189c4"
          },
          {
            "name": "Client Vol Rank",
            "expression": [
              "",
              "IF(",
              "    [Total Test Volume],",
              "    RANKX(",
              "        ALL('Client split category'[Client]),",
              "        [Total Test Volume],,",
              "        DESC,Dense",
              "    )",
              ")"
            ],
            "displayFolder": "Client Pareto",
            "lineageTag": "8ce8b4e0-dceb-487b-ad0e-bf8ef26813e3"
          },
          {
            "name": "Client Vol Denom",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Test Volume],",
              "    REMOVEFILTERS('Client split category'[Client])",
              ")"
            ],
            "displayFolder": "Client Pareto",
            "lineageTag": "5ac5f824-47a7-4b02-a00e-de602e7e6c63"
          },
          {
            "name": "Client Vol Cum. %",
            "expression": [
              "",
              "IF(",
              "    [Total Test Volume],",
              "    CALCULATE(",
              "        [Client Vol Contrib %],",
              "        WINDOW(",
              "            1, ABS,",
              "            0, REL, ",
              "            ALL('Client split category'[Client]),",
              "            ORDERBY([Total Test Volume], DESC)",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Client Pareto",
            "lineageTag": "45f353fe-be72-458e-8856-33021426fd46"
          },
          {
            "name": "Client Vol Contrib Run Total",
            "expression": [
              "",
              "IF(",
              "    [Total Test Volume], ",
              "    CALCULATE(",
              "        [Client Vol Contrib %],",
              "        WINDOW(",
              "            1, ABS,",
              "            0, REL,",
              "            ALL('Client split category'[Client]),",
              "            ORDERBY([Total Test Volume], DESC)",
              "        )",
              "    )",
              ")"
            ],
            "displayFolder": "Client Pareto",
            "lineageTag": "d3b7be62-ebbb-4f5e-87cc-4b2721a61354"
          },
          {
            "name": "Client Vol Contrib %",
            "expression": [
              "",
              "If(",
              "    [Total Test Volume],",
              "        DIVIDE(",
              "        [Total Test Volume],",
              "        [Client Vol Denom]",
              "    )",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%",
            "displayFolder": "Client Pareto",
            "lineageTag": "f9d4982b-d478-42c5-8f0b-1224d756f909"
          },
          {
            "name": "Client Vol",
            "expression": [
              "",
              "IF(",
              "    [Total Test Volume] && ISINSCOPE('Client split category'[Client]),",
              "    SELECTEDVALUE('Client split category'[Client]),        ",
              "    VAR Tble = ",
              "        FILTER(",
              "            ADDCOLUMNS(",
              "                SUMMARIZE('Client split category','Client split category'[Client], 'Client split category'[Category]),",
              "                \"Test\",",
              "                    VAR RT = ",
              "                    CALCULATE(",
              "                        DIVIDE(",
              "                            [Total Test Volume],",
              "                            CALCULATE(",
              "                                [Total Test Volume],",
              "                                ALL('Client split category'[Client])",
              "                            )",
              "                        ),",
              "                        WINDOW(",
              "                            1, ABS,",
              "                            0, REL, ",
              "                            ALL('Client split category'[Client]),",
              "                            ORDERBY([Total Test Volume], DESC)",
              "                        )",
              "                    )",
              "                    VAR Th = [Pareto Value]",
              "            RETURN",
              "                    RT <= Th && 'Client split category'[Category] = \"A+\"",
              "                ), ",
              "            [Test]",
              "        )",
              "    RETURN",
              "        IF(",
              "            CALCULATE(",
              "                [Total Test Volume],",
              "                tble",
              "            ) <> BLANK(),",
              "            \"Client Test Vol \" & FORMAT(",
              "                CALCULATE(",
              "                    [Total Test Volume],",
              "                    Tble",
              "                ), \"$0.0\"",
              "            ) & \" | \" & COUNTROWS(Tble) & \" Clients Test Vol\"",
              "        )",
              ")"
            ],
            "displayFolder": "Client Pareto",
            "lineageTag": "6a254835-cfa5-44a9-a482-2e6cec31f676"
          },
          {
            "name": "Client Rev Test",
            "expression": [
              "",
              " IF(",
              "    ISINSCOPE( 'Client split category'[Client]), ",
              "    BLANK(),",
              "    COUNTROWS(",
              "        FILTER(",
              "            SUMMARIZE(",
              "                'Client split category','Client split category'[Client], 'Client split category'[Category],",
              "                \"Test\",",
              "                    VAR RT = ",
              "                     CALCULATE(",
              "                        DIVIDE(",
              "                            [Total Revenue],",
              "                            CALCULATE(",
              "                                CALCULATE(",
              "                                    [Total Revenue],",
              "                                    ALLEXCEPT('Client split category', 'Client split category'[Category])",
              "                                ),",
              "                                KEEPFILTERS('Client split category'[Client])",
              "                            )",
              "                        ),",
              "                        WINDOW(",
              "                            1, ABS,",
              "                            0, REL, ",
              "                            ALLEXCEPT('Client split category', 'Client split category'[Category]),",
              "                            ORDERBY([Total Revenue], DESC)",
              "                        )",
              "                    )",
              "                    VAR Th = [Pareto Value]",
              "            RETURN",
              "                    RT <= Th && 'Client split category'[Category] = \"A+\"",
