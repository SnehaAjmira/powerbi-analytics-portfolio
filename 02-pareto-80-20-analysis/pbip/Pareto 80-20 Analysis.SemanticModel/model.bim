          {
            "name": "Client Rev Contrib Run Total",
            "expression": [
              "",
              "IF(",
              "    [Total Revenue], ",
              "    CALCULATE(",
              "        [Client Rev Contrib %],",
              "        WINDOW(",
              "            1, ABS,",
              "            0, REL,",
              "            ALL('Client split category'[Client]),",
              "            ORDERBY([Total Revenue], DESC)",
              "        )",
              "    )",
