          {
            "name": "FrequencyYoYColor",
            "expression": [
              "",
              "VAR LY = [Average Frequency 12M LY]",
              "VAR YoY = DIVIDE([Average Frequency 12M] - LY, LY)",
              "",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    YoY > 0, \"#a5ceff\",",
              "    OR(ISBLANK(LY), LY = 0), \"#F39C12\",",
              "    \"#F39C12\"",
              ")",
              "",
              "",
              "",
              "",
