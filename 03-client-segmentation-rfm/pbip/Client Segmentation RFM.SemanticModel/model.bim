      {
        "name": "Behavior Cohort Table",
        "lineageTag": "8d967562-7334-4041-817b-ba3634028613",
        "columns": [
          {
            "name": "Behavior Cohort",
            "dataType": "string",
            "type": "calculatedTableColumn",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Behavior Cohort]",
            "lineageTag": "2c405815-bf02-4828-98c8-e98068650424",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "Clients in Behavior Cohort",
            "expression": [
              "",
              "VAR SelectedCohort =",
              "    SELECTEDVALUE('Behavior Cohort Table'[Behavior Cohort])",
              "RETURN",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Dim Client'[Client_Facility]),",
              "        [Behavior Cohort Advanced] = SelectedCohort",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "e1b57eef-468b-47ee-9aa5-ba923833f564"
          }
        ],
        "partitions": [
          {
            "name": "Behavior Cohort Table",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE(",
                "    \"Behavior Cohort\", STRING,",
                "    {",
                "        {\"Champions (Growing)\"},",
                "        {\"Champions (Stable)\"},",
                "        {\"High Value Declining\"},",
                "        {\"High Value At Risk\"},",
                "        {\"Loyal High Frequency\"},",
                "        {\"Consistent Clients\"},",
                "        {\"Growing Mid-Tier\"},",
                "        {\"New High Potential\"},",
                "        {\"Emerging Clients\"},",
                "        {\"Upsell Candidates\"},",
                "        {\"At Risk Loyal\"},",
                "        {\"Declining Clients\"},",
                "        {\"Churn Risk\"},",
                "        {\"Lost High Value\"},",
                "        {\"Dormant\"},",
                "        {\"One-Time Clients\"},",
                "        {\"Others\"}",
                "    }",
                ")"
              ]
            },
            "mode": "import"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "e5e74aa9f0034663ae46a2a353488cbf"
          }
        ]
      },
