        "measures": [
          {
            "name": "T. Consultations",
            "expression": [
              "COUNT('Consulting Activities'[Activity_Id])"
            ],
            "formatString": "0",
            "lineageTag": "f7123d14-ea37-4d3b-9c61-236bcdeb6466"
          },
          {
            "name": "Cons. Rev.",
            "expression": [
              "sum('Consulting Activities'[Price])"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "89cfd1e2-7981-4704-9768-47cc0e5b4e30"
          },
          {
            "name": "Highest Cons. Revenue Contributor",
            "expression": [
              "",
              "CALCULATE(",
              "    SELECTEDVALUE('Consulting Activities'[Client_Facility_Name]),",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE(",
              "            'Consulting Activities',",
              "            'Consulting Activities'[Client_Facility_Name],",
              "            \"Revenue\", SUM( 'Consulting Activities'[Price])",
              "        ),",
              "        [Revenue], DESC",
              "    )",
              ")"
            ],
            "lineageTag": "3d9dc12a-4d0c-4f9f-90ca-ae4beb020b79"
          },
          {
            "name": "Highest Cons. Activity Contributor",
            "expression": [
              "",
              "CALCULATE(",
              "    SELECTEDVALUE('Consulting Activities'[Client_Facility_Name]),",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE(",
              "            'Consulting Activities',",
              "            'Consulting Activities'[Client_Facility_Name],",
              "            \"Consulting\", COUNT('Consulting Activities'[Activity_Id])",
              "        ),",
              "        [Consulting], DESC",
              "    )",
              ")"
            ],
            "lineageTag": "f8b2ff72-0a8a-4db5-804b-a82d62a3cc1a"
          }
        ],
        "partitions": [
          {
            "name": "Consulting Activities",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Excel.Workbook(File.Contents(DataFolder & \"Consulting Activities.xlsx\"), null, true),",
                "    #\"Consulting Activities_Sheet\" = Source{[Item=\"Consulting Activities\",Kind=\"Sheet\"]}[Data],",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Consulting Activities_Sheet\", [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"Activity_Id\", type text}, {\"Client_Facility_Name\", type text}, {\"Project_Name\", type text}, {\"PO_Number\", type text}, {\"Quote_Number\", type text}, {\"Invoice_Number\", Int64.Type}, {\"Billing_Codes\", type text}, {\"Billing_Domain\", type text}, {\"Estimated_Completion_Date\", type date}, {\"Completed\", type text}, {\"Completion_Date\", type date}, {\"Invoiced\", type text}, {\"Invoice_Submitted_Date\", type date}, {\"Price\", type number}, {\"Description\", type text}, {\"Expenses_Price\", type number}, {\"Expenses_Description\", type text}, {\"Entered_By\", type text}})",
                "in",
                "    #\"Changed Type\""
              ]
            },
            "mode": "import"
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
      },
