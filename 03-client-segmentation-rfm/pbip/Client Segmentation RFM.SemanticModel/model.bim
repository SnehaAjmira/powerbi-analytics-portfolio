        "measures": [
          {
            "name": "Product Revenue",
            "expression": [
              "SUM('Fact Table (Products)'[Order_Total])"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "c51f1287-d2a4-4cce-8938-c8319a7d767c",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Total Products",
            "expression": [
              "Sum('Fact Table (Products)'[Ordered])"
            ],
            "formatString": "#,0",
            "lineageTag": "d064932a-6a98-4a34-a5a1-5cb8c0088d62"
          },
          {
            "name": "Total Product Clients",
            "expression": [
              "DISTINCTCOUNT('Fact Table (Products)'[Client_Facility])"
            ],
            "formatString": "0",
            "lineageTag": "20410c8b-c6ef-4a6b-bd12-4b423977dbdd"
          },
          {
            "name": "Highest Prod. Revenue Contributor",
            "expression": [
              "",
              "CALCULATE(",
              "    SELECTEDVALUE('Fact Table (Products)'[Client_Facility]),",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE(",
              "            'Fact Table (Products)',",
              "            'Fact Table (Products)'[Client_Facility],",
              "            \"Revenue\", SUM( 'Fact Table (Products)'[Order_Total])",
              "        ),",
              "        [Revenue], DESC",
              "    )",
              ")"
            ],
            "lineageTag": "1142059d-df61-4fc6-a21a-ebe63c2191b8"
          },
          {
            "name": "Highest Prod.Volume Contributor",
            "expression": [
              "",
              "CALCULATE(",
              "    SELECTEDVALUE('Fact Table (Products)'[Client_Facility]),",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE(",
              "            'Fact Table (Products)',",
              "            'Fact Table (Products)'[Client_Facility],",
              "            \"Items\", SUM('Fact Table (Products)'[Ordered])",
              "        ),",
              "        [Items], DESC",
              "    )",
              ")"
            ],
            "lineageTag": "2e46b502-ce56-43d4-9274-8f1703b9c09a"
          }
        ],
        "partitions": [
          {
            "name": "Fact Table (Products)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Excel.Workbook(File.Contents(DataFolder & \"Product Test.xlsx\"), null, true),",
                "    #\"Order Details_Sheet\" = Source{[Item=\"Order Details\",Kind=\"Sheet\"]}[Data],",
                "    #\"Promoted Headers\" = Table.PromoteHeaders(#\"Order Details_Sheet\", [PromoteAllScalars=true]),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(#\"Promoted Headers\",{{\"Order_Number\", type text}, {\"Item\", type text}, {\"Packaging\", type text}, {\"Ordered\", Int64.Type}, {\"Shipped\", Int64.Type}, {\"Unit_Price\", Int64.Type}, {\"Ext_Price\", Int64.Type}}),",
                "    #\"Merged Queries\" = Table.NestedJoin(#\"Changed Type\", {\"Order_Number\"}, #\"Client Orders\", {\"Order_Number\"}, \"Client Orders\", JoinKind.LeftOuter),",
                "    #\"Renamed Columns\" = Table.RenameColumns(#\"Merged Queries\",{{\"Client Orders\", \"Client Orders Header\"}}),",
                "    #\"Expanded Client Orders Header\" = Table.ExpandTableColumn(#\"Renamed Columns\", \"Client Orders Header\", {\"Client_Facility\", \"Order_Date\", \"Line_Count\", \"Line_Total\", \"Shipping_And_Handling\", \"Tax\", \"Discount\", \"Order_Total\"}, {\"Client_Facility\", \"Order_Date\", \"Line_Count\", \"Line_Total\", \"Shipping_And_Handling\", \"Tax\", \"Discount\", \"Order_Total\"})",
                "in",
                "    #\"Expanded Client Orders Header\""
              ]
            },
            "mode": "import"
          }
        ],
