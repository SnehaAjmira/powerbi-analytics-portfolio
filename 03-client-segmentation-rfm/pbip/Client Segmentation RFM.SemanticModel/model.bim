        ],
        "measures": [
          {
            "name": "Clients in Early Warning Status",
            "expression": [
              "",
              "VAR SelectedStatus =",
              "    SELECTEDVALUE('Early Warning Table'[Early Warning Band])",
              "RETURN",
              "COUNTROWS(",
              "    FILTER(",
              "        VALUES('Dim Client'[Client_Facility]),",
              "        [Early Warning Band] = SelectedStatus",
              "    )",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "2129efaa-7979-44d7-881d-cf011c7f7c18",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "Early Warning Table",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "DATATABLE(",
                "    \"Early Warning Band\", STRING,",
                "    {",
                "        {\"Accelerating\"},",
                "        {\"Improving\"},",
                "        {\"Stable\"},",
                "        {\"Early Decline\"},",
                "        {\"Sharp Decline\"},",
                "        {\"No Prior Period\"}",
                "    }",
                ")"
              ]
            },
            "mode": "import"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "99e4201780da490bbd8142e4c29ffed1"
          }
        ]
