        "measures": [
          {
            "name": "List of City values",
            "expression": [
              "",
              "VAR __DISTINCT_VALUES_COUNT = DISTINCTCOUNT('Client_Facility'[BillTo_City])",
              "VAR __MAX_VALUES_TO_SHOW = 5",
              "RETURN",
              "    IF(",
              "        __DISTINCT_VALUES_COUNT > __MAX_VALUES_TO_SHOW,",
              "        CONCATENATE(",
              "            CONCATENATEX(",
              "                TOPN(",
              "                    __MAX_VALUES_TO_SHOW,",
              "                    VALUES('Client_Facility'[BillTo_City]),",
              "                    'Client_Facility'[BillTo_City],",
              "                    ASC",
              "                ),",
              "                'Client_Facility'[BillTo_City],",
              "                \", \",",
              "                'Client_Facility'[BillTo_City],",
              "                ASC",
              "            ),",
              "            \", etc.\"",
              "        ),",
              "        CONCATENATEX(",
              "            VALUES('Client_Facility'[BillTo_City]),",
              "            'Client_Facility'[BillTo_City],",
              "            \", \",",
              "            'Client_Facility'[BillTo_City],",
              "            ASC",
              "        )",
              "    )"
            ],
            "lineageTag": "13a8262e-a15c-495c-97ce-11bf8b4fa4de",
            "extendedProperties": [
              {
                "type": "json",
                "name": "MeasureTemplate",
                "value": {
                  "version": 0,
                  "daxTemplateName": "ConcatenateValues"
                }
              }
            ]
          },
          {
            "name": "Services Revenue",
            "expression": [
              "Sum('Fact Table (Services)'[Price])"
            ],
            "formatString": "\\$#,0;(\\$#,0);\\$#,0",
            "lineageTag": "df2943be-a5cf-4190-9d7f-710e106bd69e",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Total Tests",
            "expression": [
              "Count( 'Fact Table (Services)'[Test_Id])"
            ],
            "formatString": "#,0",
            "lineageTag": "e35a8d68-40b4-46eb-a3b8-928ca1b866ee"
          },
          {
            "name": "Total Clients",
            "expression": [
              "DISTINCTCOUNT('Fact Table (Services)'[Client_Facility])"
            ],
            "formatString": "0",
            "lineageTag": "d4e7f609-7774-41f6-a369-5c658b28c259"
          },
          {
            "name": "Rev QoQ",
            "expression": [
              "",
              "VAR CurrentQuarterRev = SUM('Fact Table (Services)'[Price])",
              "VAR PreviousQuarterRev =",
              "    CALCULATE(",
              "        SUM('Fact Table (Services)'[Price]),",
              "        DATEADD('Date'[Date], -1, QUARTER)",
              "    )",
              "RETURN",
              "    DIVIDE(CurrentQuarterRev - PreviousQuarterRev, PreviousQuarterRev)",
              "",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "f198c70d-ce9b-4493-b666-98d99caab660"
          },
          {
            "name": "Vol QoQ",
            "expression": [
              "",
              "VAR CurrentQuarterVol = COUNT('Fact Table (Services)'[Test_Id])",
              "VAR PreviousQuarterRev = ",
              "    CALCULATE(",
              "        COUNT('Fact Table (Services)'[Test_Id]),",
              "        DATEADD('Date'[Date],-1,QUARTER))",
              "RETURN",
              "    DIVIDE(CurrentQuarterVol - PreviousQuarterRev,PreviousQuarterRev)"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "lineageTag": "5835aba2-471c-4dfa-87a7-04258cfb354f"
          },
          {
            "name": "Last Actual Date",
            "expression": [
              "",
              "CALCULATE (",
              "    MAX ( 'Date'[Date] ),",
              "    FILTER ( ALL ( 'Date' ), NOT ISBLANK ( [Services Revenue] ) )",
              ")",
              ""
            ],
            "formatString": "General Date",
            "displayFolder": "Forecast Measures",
            "lineageTag": "1d53ad81-74ac-4c1b-af8d-8cd8eb87f3f2"
          },
          {
            "name": "Top Revenue City",
            "expression": [
              "",
              "VAR t =",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE(",
              "            'Client_Facility',",
              "            'Client_Facility'[BillTo_City],",
              "            \"Rev\", [Services Revenue]",
              "        ),",
              "        [Rev], DESC,",
              "        'Client_Facility'[BillTo_City], ASC",
              "    )",
              "RETURN",
              "    MAXX(t, 'Client_Facility'[BillTo_City])"
            ],
            "lineageTag": "39967c30-7e54-470f-b1d9-ac242a6a6b6a"
          },
          {
            "name": "Top Revenue City Amount",
            "expression": [
              "",
              "VAR TopCity =",
              "    [Top Revenue City]",
              "RETURN",
              "    CALCULATE(",
              "        [Services Revenue],",
              "        KEEPFILTERS('Client_Facility'[BillTo_City] = TopCity)",
              "    )"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "displayFolder": "No Measures",
            "lineageTag": "1d562d7a-44ac-49a9-a8ad-61725343f793"
          },
          {
            "name": "Client Revenue Growth %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Services Revenue] - [Revenue LY],",
              "    [Revenue LY]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Client Measures",
            "lineageTag": "edcb7134-d9e4-4c7d-98a1-c3bd88e0bea4"
          },
          {
            "name": "Revenue LY",
            "expression": [
              "",
              "CALCULATE(",
              "    [Services Revenue],",
              "    DATEADD('Date'[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "displayFolder": "Client Measures",
            "lineageTag": "943812ba-818f-4786-9f44-2ea4f5da5ca4"
          },
          {
            "name": "Avg Price per Test",
            "expression": [
              "",
              "DIVIDE([Services Revenue], [Total Tests])"
            ],
            "formatString": "\\$#,0.0;(\\$#,0.0);\\$#,0.0",
            "displayFolder": "Client Measures",
            "lineageTag": "90c0fabd-bd06-428f-bd23-819639a0e4f8",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"currencyCulture\":\"en-US\"}"
              }
            ]
          },
          {
            "name": "Days Since Last Order",
            "expression": [
              "",
              "DATEDIFF([Last Client Submission Date], TODAY(), DAY)"
            ],
            "formatString": "0",
            "displayFolder": "Client Measures",
            "lineageTag": "966c4f73-1d2e-4c3e-8033-2abb727ce61a"
          },
          {
            "name": "Distinct Tests",
            "expression": [
              "",
              "DISTINCTCOUNT('Fact Table (Services)'[Test_Name])"
            ],
            "formatString": "0",
            "lineageTag": "b30e65f6-6d46-4408-a756-93299dcaaa9f"
          },
          {
            "name": "Highest Revenue Contributor",
            "expression": [
              "",
              "CALCULATE(",
              "    SELECTEDVALUE('Fact Table (Services)'[Client_Facility]),",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE(",
              "            'Fact Table (Services)',",
              "            'Fact Table (Services)'[Client_Facility],",
              "            \"Revenue\", SUM( 'Fact Table (Services)'[Price])",
              "        ),",
              "        [Revenue], DESC",
              "    )",
              ")",
              ""
            ],
            "lineageTag": "41758d70-e7e2-4b91-8e9c-cd5680bf0617"
          },
          {
            "name": "Highest Volume Contributor",
            "expression": [
              "",
              "CALCULATE(",
              "    SELECTEDVALUE('Fact Table (Services)'[Client_Facility]),",
              "    TOPN(",
              "        1,",
              "        SUMMARIZE(",
              "            'Fact Table (Services)',",
              "            'Fact Table (Services)'[Client_Facility],",
              "            \"Tests\", COUNTROWS('Fact Table (Services)')",
              "        ),",
              "        [Tests], DESC",
              "    )",
              ")"
            ],
            "displayFolder": "Client Measures",
            "lineageTag": "e2c54500-96d0-4cb5-974f-a422055288fb"
          },
          {
            "name": "Active Clients in Services",
            "expression": [
              "",
              "DISTINCTCOUNT('Fact Table (Services)'[Client_Facility])"
            ],
            "formatString": "0",
            "displayFolder": "Client Measures",
            "lineageTag": "aad8135f-d48b-45a1-a33f-03b82825039e"
          },
          {
            "name": "Total Lot Numbers",
            "expression": [
              "DISTINCTCOUNT('Fact Table (Services)'[Lot_Number])"
            ],
            "formatString": "0",
            "displayFolder": "Client Measures",
            "lineageTag": "a09a2efa-51b2-4a79-9676-ee532ffe914d"
          },
          {
            "name": "Average Price",
            "expression": [
              "Average('Fact Table (Services)'[Price])"
            ],
            "displayFolder": "Client Measures",
            "lineageTag": "6536a998-b9cd-4ef0-9329-3fcf6d380815",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ]
          },
          {
            "name": "Batch",
            "expression": [
              "DISTINCTCOUNT('Fact Table (Services)'[Lot_Number])"
            ],
            "formatString": "0",
            "lineageTag": "25e62710-03e2-421d-965d-901275c1a351"
          },
          {
            "name": "Rev MoM Icon",
            "expression": [
              "",
              "VAR CurrentMonthRev = SUM('Fact Table (Services)'[Price])",
              "VAR PreviousMonthRev =",
              "    CALCULATE(",
              "        SUM('Fact Table (Services)'[Price]),",
              "        DATEADD('Date'[Date], -1, MONTH)",
              "    )",
              "VAR Pct = DIVIDE(CurrentMonthRev - PreviousMonthRev, PreviousMonthRev)",
              "RETURN",
              "    IF(Pct > 0, \"▲ \" & FORMAT(Pct, \"0.0%\"),",
              "    IF(Pct < 0, \"▼ \" & FORMAT(Pct, \"0.0%\"), \"—\"))"
            ],
            "lineageTag": "2d571fe4-d1d8-453a-969e-f9369eafdf93"
          },
          {
            "name": "Tests MoM Icon",
            "expression": [
              "",
              "VAR CurrentMonthTests = COUNTROWS('Fact Table (Services)')",
              "VAR PreviousMonthTests =",
              "    CALCULATE(",
              "        COUNTROWS('Fact Table (Services)'),",
              "        DATEADD('Date'[Date], -1, MONTH)",
              "    )",
              "VAR Pct = DIVIDE(CurrentMonthTests - PreviousMonthTests, PreviousMonthTests)",
              "RETURN",
              "    IF(Pct > 0, \"▲ \" & FORMAT(Pct, \"0.0%\"),",
              "    IF(Pct < 0, \"▼ \" & FORMAT(Pct, \"0.0%\"), \"—\"))"
            ],
            "lineageTag": "0fb9288b-130b-4827-88d7-fadae2906274"
          },
          {
            "name": "Rev MoM Color",
            "expression": [
              "",
              "VAR CurrentMonthRev = SUM('Fact Table (Services)'[Price])",
              "VAR PreviousMonthRev =",
              "    CALCULATE(",
              "        SUM('Fact Table (Services)'[Price]),",
              "        DATEADD('Date'[Date], -1, MONTH)",
              "    )",
              "VAR Pct = DIVIDE(CurrentMonthRev - PreviousMonthRev, PreviousMonthRev)",
              "RETURN",
              "    IF(Pct > 0, \"#2E7D32\", IF(Pct < 0, \"#CC5500\", \"#808080\"))"
            ],
            "lineageTag": "03b8cc6d-fca3-4ac4-ae70-f8e2003e9509"
          },
          {
            "name": "Tests MoM Color",
            "expression": [
              "",
              "VAR CurrentMonthTests = COUNTROWS('Fact Table (Services)')",
              "VAR PreviousMonthTests =",
              "    CALCULATE(",
              "        COUNTROWS('Fact Table (Services)'),",
              "        DATEADD('Date'[Date], -1, MONTH)",
              "    )",
              "VAR Pct = DIVIDE(CurrentMonthTests - PreviousMonthTests, PreviousMonthTests)",
              "RETURN",
              "    IF(Pct > 0, \"#2E7D32\", IF(Pct < 0, \"#CC5500\", \"#808080\"))"
            ],
            "lineageTag": "e1f640f5-561e-4de9-8f10-e8031c2e56f6"
          },
          {
            "name": "Count BUD",
            "expression": [
              "CALCULATE(",
              "    DISTINCTCOUNT('Fact Table (Services)'[Submission_Number]),",
              "    'Fact Table (Services)'[BUD_Test_Points] = \"BUD\"",
              ")"
            ],
            "formatString": "0",
            "lineageTag": "da228eb2-a3b5-4979-a57c-3c90499e2c34"
          }
        ],
        "partitions": [
          {
            "name": "Fact Table (Services)",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Table.Combine({RAW_2023, RAW_2024, RAW_2025, RAW_2026, Canada_2026}),",
                "    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"Submission_Release_Date\", type date}, {\"Submission_Date\", type date}, {\"Estimated_Completion_Date\", type date}, {\"Completion_Date\", type date}}),",
