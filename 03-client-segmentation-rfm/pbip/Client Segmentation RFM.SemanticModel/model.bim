                "    #\"Removed Columns\" = Table.RemoveColumns(#\"Added Custom\",{\"Test_Point\"}),",
                "    #\"Sorted Rows\" = Table.Sort(#\"Removed Columns\",{{\"Submission_Date\", Order.Descending}}),",
                "    #\"Filtered Rows\" = Table.SelectRows(#\"Sorted Rows\", each true)",
                "in",
                "    #\"Filtered Rows\""
              ]
            },
            "mode": "import"
          }
