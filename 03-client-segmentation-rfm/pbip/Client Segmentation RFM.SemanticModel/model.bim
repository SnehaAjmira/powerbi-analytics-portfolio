      {
        "name": "Dim Client",
        "lineageTag": "dccd21c3-012a-47a9-87ff-ad3fd2f5562f",
        "columns": [
          {
            "name": "Client_Facility",
            "dataType": "string",
            "type": "calculatedTableColumn",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "Fact Table (Services)[Client_Facility]",
            "lineageTag": "edc5acb1-16e9-46a7-b120-9d85ec87e478",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "measures": [
          {
            "name": "F Score",
            "expression": [
              "",
              "IF(",
              "    ISBLANK([Frequency 12M]),",
              "    BLANK(),",
              "    VAR Pct = DIVIDE([Frequency Rank], [Client Count])",
              "    RETURN",
              "        SWITCH(",
              "            TRUE(),",
              "            Pct <= 0.2, 5,",
              "            Pct <= 0.4, 4,",
              "            Pct <= 0.6, 3,",
              "            Pct <= 0.8, 2,",
              "            1",
              "        )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "RFM Score",
            "lineageTag": "c15e3feb-8d28-40e8-a8d7-54f00de290a6"
          },
          {
            "name": "Frequency 12M",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Tests],",
              "    DATESINPERIOD(",
              "        'Date'[Date],",
              "        [Analysis Date],",
              "        -12,",
              "        MONTH",
              "    )",
              ")"
            ],
            "formatString": "#,0",
            "displayFolder": "RFM Score",
            "lineageTag": "7a4e452d-60dd-4531-8ea4-b180ab27088e"
          },
          {
            "name": "Frequency Rank",
            "expression": [
              "",
              "RANKX(",
              "    ALLSELECTED('Dim Client'[Client_Facility]),",
              "    [Frequency 12M],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "RFM Score",
            "lineageTag": "20560671-4ce0-4131-8fab-5673bf530f91"
          },
          {
            "name": "M Score",
            "expression": [
              "",
              "IF(",
              "    ISBLANK([Monetary 12M]),",
              "    BLANK(),",
              "    VAR Pct = DIVIDE([Monetary Rank], [Client Count])",
              "    RETURN",
              "        SWITCH(",
              "            TRUE(),",
              "            Pct <= 0.2, 5,",
              "            Pct <= 0.4, 4,",
              "            Pct <= 0.6, 3,",
              "            Pct <= 0.8, 2,",
              "            1",
              "        )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "RFM Score",
            "lineageTag": "9184afa1-a8db-4ca9-9569-c906ec373c8a"
          },
          {
            "name": "Monetary 12M",
            "expression": [
              "",
              "CALCULATE(",
              "    [Services Revenue],",
              "    DATESINPERIOD(",
              "        'Date'[Date],",
              "        [Analysis Date],",
              "        -12,",
              "        MONTH",
              "    )",
              ")",
              ""
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "displayFolder": "RFM Score",
            "lineageTag": "d087fefa-0ae9-468d-9ccf-860669c8a5e8"
          },
          {
            "name": "Monetary Rank",
            "expression": [
              "",
              "RANKX(",
              "    ALLSELECTED('Dim Client'[Client_Facility]),",
              "    [Monetary 12M],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "RFM Score",
            "lineageTag": "f50ac4d5-ad05-48c1-bba4-fbbb58f5acac"
          },
          {
            "name": "R Score",
            "expression": [
              "",
              "IF(",
              "    ISBLANK([Last Client Submission Date]),",
              "    BLANK(),",
              "    SWITCH(",
              "        TRUE(),",
              "        [Recency] <= 1, 5,",
              "        [Recency] <= 3, 4,",
              "        [Recency] <= 6, 3,",
              "        [Recency] <= 12, 2,",
              "        1",
              "    )",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "RFM Score",
            "lineageTag": "ebdc517f-9112-478d-b657-f5b8dc235e79"
          },
          {
            "name": "Recency",
            "expression": [
              "",
              "DATEDIFF([Last Client Submission Date], [Analysis Date], MONTH)"
            ],
            "formatString": "0",
            "displayFolder": "RFM Score",
            "lineageTag": "e88f08bb-4b57-4e70-bb2a-df7856a32ff6"
          },
          {
            "name": "Total Submissions",
            "expression": [
              "DISTINCTCOUNT('Fact Table (Services)'[Submission_Number])"
            ],
            "formatString": "0",
            "displayFolder": "RFM Score",
            "lineageTag": "f2492dd7-ad00-4aa7-8eb1-5cc709b23a9c"
          },
          {
            "name": "Last Client Submission Date",
            "expression": [
              "",
              "MAX('Fact Table (Services)'[Submission_Date])"
            ],
            "formatString": "Short Date",
            "displayFolder": "RFM Score",
            "lineageTag": "54c7d29c-e273-4ff8-ba38-457782ec258f"
          },
          {
            "name": "Last Update",
            "expression": [
              "",
              "    MAX ( 'Fact Table (Services)'[Completion_Date] )"
            ],
            "formatString": "m/d/yyyy",
            "displayFolder": "RFM Score",
            "lineageTag": "f705db6a-c306-43b6-8b07-b14fe45150f8",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDateTimeCustom\":true}"
              }
            ]
          },
          {
            "name": "Client Count",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Dim Client'[Client_Facility]),",
              "    ALLSELECTED('Dim Client'[Client_Facility])",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "RFM Score",
            "lineageTag": "59a32645-8a47-4d60-b193-4bc8863a6823"
          },
          {
            "name": "Analysis Date",
            "expression": [
              "",
              "MAX('Date'[Date])"
            ],
            "formatString": "m/d/yy",
            "displayFolder": "RFM Score",
            "lineageTag": "0bf0723c-bea2-4b96-a599-f5d19b15b400",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isDateTimeCustom\":true}"
              }
            ]
          },
          {
            "name": "Analysis Date LY",
            "expression": [
              "",
              "EOMONTH( EDATE([Analysis Date], -12), 0 )",
              ""
            ],
            "formatString": "General Date",
            "displayFolder": "RFM Score",
            "lineageTag": "65a6543a-2982-4745-8735-3bd58a20d01d"
          },
          {
            "name": "Last Client Submission Date LY",
            "expression": [
              "",
              "VAR LYDate = [Analysis Date LY]",
              "RETURN",
              "CALCULATE(",
              "    MAX('Fact Table (Services)'[Submission_Date]),",
              "    REMOVEFILTERS('Date'),",
              "    KEEPFILTERS(VALUES('Dim Client'[Client_Facility])),",
              "    'Fact Table (Services)'[Submission_Date] <= LYDate",
              ")",
              ""
            ],
            "formatString": "General Date",
            "displayFolder": "RFM Score",
            "lineageTag": "0660eb55-f32c-4327-897e-b165f57d047e"
          },
          {
            "name": "Recency Months LY",
            "expression": [
              "",
              "VAR LastDt = [Last Client Submission Date LY]",
              "VAR LYDate = [Analysis Date LY]",
              "RETURN",
              "IF(",
              "    NOT ISBLANK(LastDt),",
              "    DATEDIFF(LastDt, LYDate, MONTH),",
              "    BLANK()",
              ")",
              "",
              "",
              ""
