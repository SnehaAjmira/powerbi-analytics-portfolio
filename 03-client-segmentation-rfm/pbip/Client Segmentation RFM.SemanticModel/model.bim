              ""
            ],
            "displayFolder": "RFM Score",
            "lineageTag": "d3201f0b-ee27-49dc-9291-4f119a221e85"
          },
          {
            "name": "Behavior Cohort Advanced",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "",
              "    -- 🔵 Champions",
              "    [R Score]>=4 && [F Score]>=4 && [M Score]>=4 && [Revenue Trend %] > 0,",
              "    \"Champions (Growing)\",",
              "",
              "    [R Score]>=4 && [F Score]>=4 && [M Score]>=4 && ABS([Revenue Trend %]) <= 0.05,",
              "    \"Champions (Stable)\",",
              "",
              "    [M Score]>=4 && [Revenue Trend %] < -0.1,",
              "    \"High Value Declining\",",
              "",
              "    [M Score]>=4 && [R Score]<=2,",
              "    \"High Value At Risk\",",
              "",
              "    -- 🟢 Core",
              "    [F Score]>=4 && [M Score]>=3,",
              "    \"Loyal High Frequency\",",
              "",
              "    [R Score]>=3 && [F Score]>=3 && [M Score]>=3,",
              "    \"Consistent Clients\",",
              "",
              "    [M Score]>=3 && [Revenue Trend %] > 0.1,",
              "    \"Growing Mid-Tier\",",
              "",
              "    -- 🟡 Growth",
              "    [R Score]>=4 && [M Score]>=3,",
              "    \"New High Potential\",",
              "",
              "    [Revenue Trend %] > 0.1 && [F Score]<=2,",
              "    \"Emerging Clients\",",
              "",
              "    [F Score]>=3 && [M Score]<=2,",
              "    \"Upsell Candidates\",",
              "",
              "    -- 🟠 Risk",
              "    [F Score]>=4 && [R Score]<=2,",
              "    \"At Risk Loyal\",",
              "",
              "    [Revenue Trend %] < -0.1,",
              "    \"Declining Clients\",",
              "",
              "    [R Score]<=2 && [Revenue Trend %] < 0,",
              "    \"Churn Risk\",",
              "",
              "    -- 🔴 Lost",
              "    [R Score]=1 && [M Score]>=4,",
              "    \"Lost High Value\",",
              "",
              "    [R Score]=1,",
              "    \"Dormant\",",
              "",
              "    [F Score]=1,",
              "    \"One-Time Clients\",",
              "",
              "    \"Others\"",
              ")"
            ],
            "displayFolder": "RFM Score",
            "lineageTag": "ed871dd6-917f-4798-b372-d272bc6162e7"
          },
          {
            "name": "Revenue Trend %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Monetary 12M] - [Monetary 12M LY],",
              "    [Monetary 12M LY]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "RFM Score",
            "lineageTag": "17d39410-d621-4796-beab-29b5bcf15bd1"
          },
          {
            "name": "Revenue Recent 6M",
            "expression": [
              "",
              "CALCULATE(",
              "    [Services Revenue],",
              "    DATESINPERIOD(",
              "        'Date'[Date],",
              "        [Analysis Date],",
              "        -6,",
              "        MONTH",
              "    )",
              ")"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "displayFolder": "RFM Score",
            "lineageTag": "995ae5b0-3cac-417e-b3ff-7be94e4f812f"
          },
          {
            "name": "Revenue Prior 6M",
            "expression": [
              "",
              "CALCULATE(",
              "    [Services Revenue],",
              "    DATESINPERIOD(",
              "        'Date'[Date],",
              "        EDATE([Analysis Date], -6),",
              "        -6,",
              "        MONTH",
              "    )",
              ")"
            ],
            "formatString": "\\$#,0.###############;(\\$#,0.###############);\\$#,0.###############",
            "displayFolder": "RFM Score",
            "lineageTag": "3887ea7a-73b9-4a37-9eba-c76a26265eeb"
          },
          {
            "name": "Revenue Trend 6M %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Revenue Recent 6M] - [Revenue Prior 6M],",
              "    [Revenue Prior 6M]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "RFM Score",
            "lineageTag": "f33346f8-8adc-44ce-adde-7c19b7ab8094"
          },
          {
            "name": "Early Warning Band",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    ISBLANK([Revenue Prior 6M]), \"No Prior 6M\",",
              "    [Revenue Trend 6M %] <= -0.30, \"Sharp Decline\",",
              "    [Revenue Trend 6M %] <= -0.10, \"Early Decline\",",
              "    [Revenue Trend 6M %] < 0.10, \"Stable\",",
              "    [Revenue Trend 6M %] < 0.30, \"Improving\",",
              "    \"Accelerating\"",
              ")"
            ],
            "displayFolder": "RFM Score",
            "lineageTag": "1c472f9d-c167-490d-bde1-fca415af3044"
          }
        ],
        "partitions": [
          {
            "name": "Dim Client",
            "source": {
              "type": "calculated",
              "expression": [
                "DISTINCT(",
